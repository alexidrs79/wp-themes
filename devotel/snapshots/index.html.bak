					<div class="fcta7cf-sent-body">
						<div class="fcta7cf-sent-hero">
							<div class="fcta7cf-sent-ficon">
								<div class="fcta7cf-sent-fbg">
								</div>
								<div class="fcta7cf-sent-fglass">
									<p><svg class="fcta7cf-sent-check" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<path
											d="M7.5 12L10.5 15L16.5 9M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
											stroke="#ffffff"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									</p>
