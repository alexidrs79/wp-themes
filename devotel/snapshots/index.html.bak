						<a href="https://orbit.devotel.io" class="mobile-login-item">
							<div class="mobile-login-item-content">
								<div class="mobile-login-item-text">Orbit</div>
							</div>
							<svg class="mobile-login-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M4.875 13.125L13.125 4.875M13.125 4.875H6.375M13.125 4.875V11.625" stroke="#45556c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
						<a href="https://devhub.devotel.com/signin" class="mobile-login-item">
							<div class="mobile-login-item-content">
								<div class="mobile-login-item-text">DevHub</div>
							</div>
							<svg class="mobile-login-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M4.875 13.125L13.125 4.875M13.125 4.875H6.375M13.125 4.875V11.625" stroke="#45556c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
