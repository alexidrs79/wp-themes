						<div class="fcta7cf-sent-actions">
							<p><button type="button" class="fcta7cf-sent-backbtn" data-fcta7cf-action="sent-back"><br />
<svg class="fcta7cf-sent-backico" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M15.8359 10L4.16927 10" stroke="#62748e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									<path d="M10 15.833L4.16667 9.99968L10 4.16634" stroke="#62748e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg><br />
<span class="fcta7cf-sent-backlbl">Send Another Message</span><br />
</button>
							</p>
