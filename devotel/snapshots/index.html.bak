								<path d="M18.499 9.56055L7.89648 20.1631C7.56607 20.4935 7.15728 20.7349 6.70801 20.8633L3.76465 21.7041C3.65861 21.7344 3.54874 21.75 3.43848 21.75C2.78209 21.7499 2.25 21.2169 2.25 20.5605C2.25004 20.4503 2.2656 20.3404 2.2959 20.2344L3.13672 17.292C3.26511 16.8426 3.50546 16.433 3.83594 16.1025L14.4385 5.5L18.499 9.56055ZM18.5 2.25C19.019 2.25 19.5168 2.45624 19.8838 2.82324L21.1768 4.11621C21.5438 4.48323 21.75 4.98096 21.75 5.5C21.75 6.01904 21.5438 6.51676 21.1768 6.88379L19.5596 8.5L15.499 4.43945L17.1162 2.82324C17.4832 2.45624 17.981 2.25 18.5 2.25Z" fill="#325FEC"/>
