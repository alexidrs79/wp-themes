						stroke="#fff" 
						stroke-width="1.66566" 
						stroke-linecap="round" 
						stroke-linejoin="round"
					/>
					<path 
						d="M10 4.16699L15.8333 10.0003L10 15.8337" 
						stroke="#fff" 
						stroke-width="1.66566" 
						stroke-linecap="round" 
						stroke-linejoin="round"
					/>
            </svg>
                        </div>
		</a>
		
		<!-- Secondary Button -->
		<a href="https://devotel.com/contact-us/" class="btn-secondary">
			<div class="btn-inner">
				<span class="btn-label">
