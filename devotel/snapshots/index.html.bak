			            padding 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			            min-width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			            max-width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}
