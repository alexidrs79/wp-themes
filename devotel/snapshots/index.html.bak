            <path d="M53.7783 22.2124C50.4248 19.3768 46.4006 17.959 42.1528 17.7227L41.4821 18.4316C45.2827 19.3768 48.6362 21.2672 51.7662 23.8666C47.9655 21.7398 43.7177 20.322 39.2464 19.8494C37.905 19.6131 36.7871 19.6131 35.4457 19.6131C34.1043 19.6131 32.9865 19.6131 31.6451 19.8494C27.1737 20.322 22.9259 21.7398 19.1252 23.8666C22.2552 21.2672 25.6087 19.3768 29.4094 18.4316L28.7387 17.7227C24.4909 17.959 20.4666 19.3768 17.1131 22.2124C13.3125 29.7742 11.3004 38.2812 11.0768 47.0244C14.4303 50.8053 19.1252 53.1684 24.0437 53.1684C24.0437 53.1684 25.6087 51.2779 26.7266 49.6238C23.8202 48.9149 21.1374 47.2608 19.3488 44.6614C20.9138 45.6066 22.4788 46.5518 24.0437 47.2608C26.0559 48.206 28.068 48.6786 30.0801 49.1512C31.8686 49.3875 33.6572 49.6238 35.4457 49.6238C37.2343 49.6238 39.0228 49.3875 40.8114 49.1512C42.8235 48.6786 44.8356 48.206 46.8477 47.2608C48.4127 46.5518 49.9776 45.6066 51.5426 44.6614C49.7541 47.2608 47.0713 48.9149 44.1649 49.6238C45.2827 51.2779 46.8477 53.1684 46.8477 53.1684C51.7662 53.1684 56.4611 50.8053 59.8146 47.0244C59.5911 38.2812 57.579 29.7742 53.7783 22.2124ZM28.068 42.771C25.8323 42.771 23.8202 40.6442 23.8202 38.0449C23.8202 35.4455 25.8323 33.3188 28.068 33.3188C30.3036 33.3188 32.3158 35.4455 32.3158 38.0449C32.3158 40.6442 30.3036 42.771 28.068 42.771ZM42.8235 42.771C40.5878 42.771 38.5757 40.6442 38.5757 38.0449C38.5757 35.4455 40.5878 33.3188 42.8235 33.3188C45.0591 33.3188 47.0713 35.4455 47.0713 38.0449C47.0713 40.6442 45.0591 42.771 42.8235 42.771Z" fill="white" />
