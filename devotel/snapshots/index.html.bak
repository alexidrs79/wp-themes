                this.maxZoom = Infinity;
                this.minPolarAngle = 0;
                this.maxPolarAngle = Math.PI;
                this.minAzimuthAngle = -Infinity;
                this.maxAzimuthAngle = Infinity;
                this.enableDamping = false;
                this.dampingFactor = 0.25;
                this.enableZoom = true;
                this.zoomSpeed = 1.0;
                this.enableRotate = true;
                this.rotateSpeed = 1.0;
                this.enablePan = true;
                this.panSpeed = 1.0;
                this.autoRotate = false;
                this.autoRotateSpeed = 2.0;
                this.enableKeys = true;
                this.keys = { LEFT: 37, UP: 38, RIGHT: 39, BOTTOM: 40 };
                // THREE.MOUSE constants for r128
                var MOUSE = { LEFT: 0, MIDDLE: 1, RIGHT: 2 };
                this.mouseButtons = { LEFT: MOUSE.LEFT, MIDDLE: MOUSE.MIDDLE, RIGHT: MOUSE.RIGHT };
                
                var scope = this;
                var STATE = { NONE: -1, ROTATE: 0, DOLLY: 1, PAN: 2, TOUCH_ROTATE: 3, TOUCH_DOLLY_PAN: 4 };
                var state = STATE.NONE;
                var EPS = 0.000001;
                var spherical = new THREE.Spherical();
                var sphericalDelta = new THREE.Spherical();
                var scale = 1;
                var panOffset = new THREE.Vector3();
                var rotateStart = new THREE.Vector2();
                var rotateEnd = new THREE.Vector2();
                var rotateDelta = new THREE.Vector2();
                
                function getAutoRotationAngle() {
                    return ((2 * Math.PI) / 60 / 60) * scope.autoRotateSpeed;
                }
                
                function rotateLeft(angle) {
                    sphericalDelta.theta -= angle;
                }
                
                function rotateUp(angle) {
                    sphericalDelta.phi -= angle;
                }
                
                var panLeft = function(distance, objectMatrix) {
                    var v = new THREE.Vector3();
                    v.setFromMatrixColumn(objectMatrix, 0);
                    v.multiplyScalar(-distance);
                    panOffset.add(v);
                };
                
                var panUp = function(distance, objectMatrix) {
                    var v = new THREE.Vector3();
                    if (scope.screenSpacePanning === true) {
                        v.setFromMatrixColumn(objectMatrix, 1);
                    } else {
                        v.setFromMatrixColumn(objectMatrix, 0);
                        v.crossVectors(scope.object.up, v);
                    }
                    v.multiplyScalar(distance);
                    panOffset.add(v);
                };
                
                this.update = function() {
                    var offset = new THREE.Vector3();
                    var quat = new THREE.Quaternion().setFromUnitVectors(object.up, new THREE.Vector3(0, 1, 0));
                    var quatInverse = quat.clone().inverse();
                    var position = scope.object.position;
                    offset.copy(position).sub(scope.target);
                    offset.applyQuaternion(quat);
                    spherical.setFromVector3(offset);
                    
                    if (scope.autoRotate && state === STATE.NONE) {
                        rotateLeft(getAutoRotationAngle());
                    }
                    
                    spherical.theta += sphericalDelta.theta;
                    spherical.phi += sphericalDelta.phi;
                    spherical.theta = Math.max(scope.minAzimuthAngle, Math.min(scope.maxAzimuthAngle, spherical.theta));
                    spherical.phi = Math.max(scope.minPolarAngle, Math.min(scope.maxPolarAngle, spherical.phi));
                    // Ensure phi is within valid range (makeSafe equivalent)
                    spherical.phi = Math.max(EPS, Math.min(Math.PI - EPS, spherical.phi));
                    spherical.radius *= scale;
                    spherical.radius = Math.max(scope.minDistance, Math.min(scope.maxDistance, spherical.radius));
                    scope.target.add(panOffset);
                    offset.setFromSpherical(spherical);
                    offset.applyQuaternion(quatInverse);
                    position.copy(scope.target).add(offset);
                    scope.object.lookAt(scope.target);
                    
                    if (scope.enableDamping === true) {
                        sphericalDelta.theta *= 1 - scope.dampingFactor;
                        sphericalDelta.phi *= 1 - scope.dampingFactor;
                        panOffset.multiplyScalar(1 - scope.dampingFactor);
                    } else {
                        sphericalDelta.set(0, 0, 0);
                        panOffset.set(0, 0, 0);
                    }
                    scale = 1;
                };
                
                function handleMouseDownRotate(event) {
                    rotateStart.set(event.clientX, event.clientY);
                }
                
                function handleMouseMoveRotate(event) {
                    rotateEnd.set(event.clientX, event.clientY);
                    rotateDelta.subVectors(rotateEnd, rotateStart).multiplyScalar(scope.rotateSpeed);
                    var element = scope.domElement === document ? scope.domElement.body : scope.domElement;
                    rotateLeft((2 * Math.PI * rotateDelta.x) / element.clientHeight);
                    rotateUp((2 * Math.PI * rotateDelta.y) / element.clientHeight);
                    rotateStart.copy(rotateEnd);
                    scope.update();
                }
                
                function onMouseDown(event) {
                    if (scope.enabled === false) return;
                    event.preventDefault();
                    if (event.button === scope.mouseButtons.LEFT) {
                        if (scope.enableRotate === false) return;
                        handleMouseDownRotate(event);
                        state = STATE.ROTATE;
                        document.addEventListener('mousemove', onMouseMove, false);
                        document.addEventListener('mouseup', onMouseUp, false);
                    }
                }
                
                function onMouseMove(event) {
                    if (scope.enabled === false) return;
                    event.preventDefault();
                    if (state === STATE.ROTATE) {
                        if (scope.enableRotate === false) return;
                        handleMouseMoveRotate(event);
                    }
                }
                
                function onMouseUp(event) {
                    if (scope.enabled === false) return;
                    document.removeEventListener('mousemove', onMouseMove, false);
                    document.removeEventListener('mouseup', onMouseUp, false);
                    state = STATE.NONE;
                }
                
                function onTouchStart(event) {
                    if (scope.enabled === false) return;
                    event.preventDefault();
                    if (event.touches.length === 1) {
                        if (scope.enableRotate === false) return;
                        rotateStart.set(event.touches[0].pageX, event.touches[0].pageY);
                        state = STATE.TOUCH_ROTATE;
                    }
                }
                
                function onTouchMove(event) {
                    if (scope.enabled === false) return;
                    event.preventDefault();
                    event.stopPropagation();
                    if (event.touches.length === 1 && state === STATE.TOUCH_ROTATE) {
                        if (scope.enableRotate === false) return;
                        rotateEnd.set(event.touches[0].pageX, event.touches[0].pageY);
                        rotateDelta.subVectors(rotateEnd, rotateStart).multiplyScalar(scope.rotateSpeed);
                        var element = scope.domElement === document ? scope.domElement.body : scope.domElement;
                        rotateLeft((2 * Math.PI * rotateDelta.x) / element.clientHeight);
                        rotateUp((2 * Math.PI * rotateDelta.y) / element.clientHeight);
                        rotateStart.copy(rotateEnd);
                        scope.update();
                    }
                }
                
                function onTouchEnd(event) {
                    if (scope.enabled === false) return;
                    state = STATE.NONE;
                }
                
                function onContextMenu(event) {
                    if (scope.enabled === false) return;
                    event.preventDefault();
                }
                
                scope.domElement.addEventListener('contextmenu', onContextMenu, false);
                scope.domElement.addEventListener('mousedown', onMouseDown, false);
                scope.domElement.addEventListener('touchstart', onTouchStart, false);
                scope.domElement.addEventListener('touchend', onTouchEnd, false);
                scope.domElement.addEventListener('touchmove', onTouchMove, false);
                
                this.update();
            };
        })();
    </script>
    <script>
        // Globe 3D Setup with custom rotation system
        let scene, camera, renderer, globe, raycaster;
        
        // Global rotation state for full 360-degree rotation
        let globeRotation = { x: 0, y: 0 }; // Current rotation in radians
        let rotationVelocity = { x: 0, y: 0 }; // Rotation velocity for momentum
        let isDragging = false;
        let autoRotateEnabled = true;
        const autoRotateSpeed = 0.3; // radians per second
        const rotationDamping = 0.92; // Momentum damping factor (0.92 = smooth deceleration)
        const rotationSensitivity = 0.005; // Mouse movement to rotation conversion
    
        function initGlobe() {
            // Scope to .frame-2147227567 to prevent conflicts with other globe-containers
            const frameContainer = document.querySelector('.frame-2147227567');
            if (!frameContainer) {
                console.warn('CTAB: frameContainer not found');
                return;
            }
            const container = frameContainer.querySelector('#globe-container');
            if (!container) {
                console.warn('CTAB: globe-container not found');
                return;
            }
            
            // Prevent multiple initializations
            if (container.hasAttribute('data-globe-initialized')) {
                return;
            }
            
            // Ensure container is visible - critical for mobile
            const containerStyle = window.getComputedStyle(container);
            if (containerStyle.display === 'none' || containerStyle.visibility === 'hidden') {
                container.style.display = 'block';
                container.style.visibility = 'visible';
            }
            
            // Ensure parent layer-1 is also visible (container IS layer-1, but check anyway)
            const layer1 = container.closest('.layer-1') || container;
            if (layer1) {
                const layer1Style = window.getComputedStyle(layer1);
                if (layer1Style.display === 'none' || layer1Style.visibility === 'hidden') {
                    layer1.style.display = 'block';
                    layer1.style.visibility = 'visible';
                }
            }
            
            // Ensure container has dimensions - critical for mobile
            let width = container.offsetWidth;
            let height = container.offsetHeight;
            
            // If container has no dimensions (common in mobile before styles apply), use computed styles or defaults
            if (width === 0 || height === 0) {
                const computedStyle = window.getComputedStyle(container);
                width = parseFloat(computedStyle.width) || 500;
                height = parseFloat(computedStyle.height) || 500;
                
                // If still no dimensions, use mobile defaults
                if (width === 0 || height === 0) {
                    const isMobile = window.innerWidth <= 768;
                    width = isMobile ? 540 : 820;
                    height = isMobile ? 540 : 820;
                }
                
                // Set explicit dimensions to ensure container has size
                container.style.width = width + 'px';
                container.style.height = height + 'px';
            }
            
            // Ensure minimum dimensions
            if (width < 100) width = 100;
            if (height < 100) height = 100;
            
            // Double-check container is ready
            if (!container.parentElement) {
                console.warn('CTAB: globe-container has no parent');
                return;
            }
            
            // Mark as initialized to prevent duplicates
            container.setAttribute('data-globe-initialized', 'true');
    
            // Scene setup
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
            camera.position.z = 5;
    
            // Renderer setup
            // Clear any existing renderer to prevent duplicates
            if (renderer && renderer.domElement) {
                if (renderer.domElement.parentNode) {
                    renderer.domElement.parentNode.removeChild(renderer.domElement);
                }
                renderer.dispose();
            }
            
            // Clear any existing content in container
            container.innerHTML = '';
            
            renderer = new THREE.WebGLRenderer({ 
                alpha: true, 
                antialias: true,
                powerPreference: "high-performance"
            });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // Limit pixel ratio for performance
            
            // Append renderer canvas to container
            container.appendChild(renderer.domElement);
            
            // Ensure canvas is visible and properly sized
            renderer.domElement.style.display = 'block';
            renderer.domElement.style.width = '100%';
            renderer.domElement.style.height = '100%';
            renderer.domElement.style.position = 'relative';
            renderer.domElement.style.visibility = 'visible';
            renderer.domElement.style.opacity = '1';
    
            // Create pattern texture using the provided SVG path
            function createSVGPatternTexture() {
                const svgPathData = 'M22.801 18.6208C12.1305 18.6208 3.00408 6.23691 0 0C9.80532 11.9461 18.9228 13.0044 23.5219 12.054C34.7734 9.72903 38.6325 13.0435 39.5637 15.2025C32.7144 13.6912 21.8997 22.219 14.3295 34.1831C15.3208 29.9552 20.1273 22.129 22.801 18.6208Z';
                const svgWidth = 40;
                const svgHeight = 35;
                const scale = 4.7;
                const scaleY = scale * 1.22;
                const svgScaledWidth = svgWidth * scale;
                const svgScaledHeight = svgHeight * scaleY;
                const uniformSpacing = 95;
                const maxSvgDimension = Math.max(svgScaledWidth, svgScaledHeight);
                const uniformCellSize = maxSvgDimension + uniformSpacing;
                const uniformPatternWidth = uniformCellSize;
                const uniformPatternHeight = uniformCellSize;
                
                // Exactly 20 rows and 20 columns: texture maps once onto the globe
                const rows = 20;
                const cols = 20;
                const canvasWidth = cols * uniformCellSize;
                const canvasHeight = rows * uniformCellSize;
                const canvasSize = Math.max(canvasWidth, canvasHeight);
                
                const canvas = document.createElement('canvas');
                canvas.width = canvasWidth;
                canvas.height = canvasHeight;
                const ctx = canvas.getContext('2d');
                ctx.imageSmoothingEnabled = true;
                ctx.imageSmoothingQuality = 'high';
                ctx.clearRect(0, 0, canvasWidth, canvasHeight);
                
                const patternsPerRow = cols;
                const patternsPerCol = rows;
                
                ctx.fillStyle = '#E8F0FF'; // Brighter light blue for more visibility
                
                // Draw the SVG path repeatedly across the canvas with PERFECTLY UNIFORM spacing
                // Use uniform pattern dimensions to ensure perfect grid alignment
                // Draw enough patterns to ensure seamless tiling without gaps
                for (let row = 0; row < patternsPerCol; row++) {
                    for (let col = 0; col < patternsPerRow; col++) {
                        ctx.save();
                        
                        // Calculate center position for each cell using uniform pattern dimensions
                        // This ensures perfect alignment and uniform spacing in both directions
                        const cellCenterX = col * uniformPatternWidth + uniformPatternWidth / 2;
                        const cellCenterY = row * uniformPatternHeight + uniformPatternHeight / 2;
                        
                        // Position SVG centered in its cell
                        const x = cellCenterX - svgScaledWidth / 2;
                        const y = cellCenterY - svgScaledHeight / 2;
                        
                        ctx.translate(x, y);
                        ctx.scale(scale, -scaleY); // Stretch height (scaleY); flip vertically
                        ctx.translate(0, -svgHeight); // Adjust position after flip
                        
                        // Create and draw the path for this instance with clean edges
                        const path = new Path2D(svgPathData);
                        ctx.fill(path);
                        
                        ctx.restore();
                    }
                }
                
                // Convert canvas to texture
                const texture = new THREE.CanvasTexture(canvas);
                texture.wrapS = THREE.RepeatWrapping;
                texture.wrapT = THREE.RepeatWrapping;
                // Don't set custom repeat - let the pattern tile naturally at 1:1 scale
                // The shader will handle the scaling to match the pattern density
                texture.repeat.set(1.0, 1.0); // Use 1:1 repeat for seamless tiling
                texture.offset.set(0, 0); // Ensure no offset that could cause misalignment
                
                // Map texture once onto sphere: exactly 20 columns and 20 rows
                texture.userData = {
                    patternWidth: canvasWidth,
                    patternHeight: canvasHeight,
                    canvasSize: canvasSize
                };
                
                return texture;
            }
            
            // Create globe geometry - increased size
            const geometry = new THREE.SphereGeometry(1.55, 64, 64); // Increased from 1.3 (about 19% bigger)
            
            // Create material with SVG pattern texture and gradient
            const svgPatternTexture = createSVGPatternTexture();
            
            // Calculate pattern scale based on actual pattern dimensions for uniform spacing
            // This ensures the shader shows the correct pattern density without gaps
            const patternInfo = svgPatternTexture.userData;
            const canvasSize = patternInfo.canvasSize;
            const patternWidth = patternInfo.patternWidth;
            const patternHeight = patternInfo.patternHeight;
            // Calculate scale to show the right number of patterns per texture unit
            // This ensures uniform spacing without gaps between rows
            const patternScaleX = canvasSize / patternWidth;
            const patternScaleY = canvasSize / patternHeight;
            
            // Create gradient texture: top-to-bottom #325FEC (25.28%) -> #FFF (80.24%)
            function createGradientTexture() {
                const canvas = document.createElement('canvas');
                canvas.width = 256;
                canvas.height = 256;
                const ctx = canvas.getContext('2d');
                const gradient = ctx.createLinearGradient(0, 0, 0, 256);
                gradient.addColorStop(0, '#325FEC');
                gradient.addColorStop(0.2528, '#325FEC');
                gradient.addColorStop(0.8024, '#FFF');
                gradient.addColorStop(1, '#FFF');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, 256, 256);
                const texture = new THREE.CanvasTexture(canvas);
                return texture;
            }
            
            const gradientTexture = createGradientTexture();
            
            // Build shared shader strings once
            const globeVertexShader = `
                    varying vec2 vUv;
                    varying vec3 vNormal;
                    varying vec3 vWorldPosition;
                    void main() {
                        vUv = uv;
                        vNormal = normalize(normalMatrix * normal);
                        vWorldPosition = (modelMatrix * vec4(position, 1.0)).xyz;
                        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                    }
                `;
            const globeFragmentShader = `
                    uniform sampler2D svgPatternTexture;
                    uniform sampler2D gradientTexture;
                    uniform float time;
                    uniform float globeRotationY;
                    uniform float isDragging;
                    uniform float rotationEase;
                    uniform vec2 patternScale;
                    uniform float alphaMultiplier;
                    varying vec2 vUv;
                    varying vec3 vNormal;
                    varying vec3 vWorldPosition;
                    
                    void main() {
                        // Sample SVG pattern with proper spherical mapping
                        float baseAngle = atan(vNormal.x, vNormal.z);
                        float rotationAngle;
                        
                        if (isDragging > 0.5) {
                            rotationAngle = globeRotationY;
                        } else {
                            float rotationSpeed = 0.3;
                            rotationAngle = -time * rotationSpeed;
                        }
                        
                        float rotatedAngle = baseAngle + rotationAngle;
                        
                        vec2 patternUV = vec2(
                            rotatedAngle / 3.14159 + 0.5,
                            acos(vNormal.y) / 3.14159
                        );
                        
                        // Sample the repeating SVG pattern using calculated scale for uniform spacing
                        vec4 patternColor = texture2D(svgPatternTexture, patternUV * patternScale);
                        
                        // Only show the SVG pattern logos, make background transparent
                        float patternIntensity = (patternColor.r > 0.3 && patternColor.g > 0.3 && patternColor.b > 0.3) ? patternColor.r * 1.2 : 0.0;
                        
                        // Sample gradient 39deg: blue #325FEC (25.28%) -> white #FFF (80.24%) from top to bottom
                        float gradAxis = vNormal.x * 0.6293 - vNormal.y * 0.7771;
                        float gradV = clamp((gradAxis + 1.0) * 0.5, 0.0, 1.0);
                        vec3 basePatternColor = texture2D(gradientTexture, vec2(0.5, gradV)).rgb;
                        
                        // Add subtle pulsing glow effect for visual animation
                        float pulse = sin(time * 2.0) * 0.1 + 0.9;
                        float glow = pow(1.0 - abs(sin(time * 1.5)), 2.0) * 0.25;
                        vec3 patternColorRGB = basePatternColor * pulse + vec3(1.0, 1.0, 1.0) * glow;
                        
                        // Add subtle fresnel effect for depth and smoothness
                        vec3 viewDir = normalize(cameraPosition - vWorldPosition);
                        float fresnel = pow(1.0 - dot(vNormal, viewDir), 2.0);
                        patternColorRGB += basePatternColor * fresnel * 0.2;
                        
                        // Calculate vertical position (Y coordinate) for fade effect
                        float verticalPosition = vNormal.y;
                        float fadeStart = -0.99;
                        float fadeEnd = -1.0;
                        float fadeFactor = smoothstep(fadeEnd, fadeStart, verticalPosition);
                        
                        // alphaMultiplier: 1.0 on back mesh (full visibility), 0.7 on front mesh (so back shows through)
                        float alpha = patternIntensity * fadeFactor * alphaMultiplier;
                        vec3 finalColor = patternColorRGB;
                        
                        gl_FragColor = vec4(finalColor, alpha);
                    }
                `;
            
            function createGlobeMaterial(alphaMult, side, depthWrite) {
                return new THREE.ShaderMaterial({
                uniforms: {
                    svgPatternTexture: { value: svgPatternTexture },
                    gradientTexture: { value: gradientTexture },
                    time: { value: 0 },
                    globeRotationY: { value: 0 },
                    isDragging: { value: 0 },
                    rotationEase: { value: 1.0 },
                    patternScale: { value: new THREE.Vector2(patternScaleX, patternScaleY) },
                    alphaMultiplier: { value: alphaMult }
                },
                vertexShader: globeVertexShader,
                fragmentShader: globeFragmentShader,
                side: side,
                transparent: true,
                depthWrite: depthWrite,
                alphaTest: 0.08
            });
            }
            
            // Back mesh: draw first, 10% opacity so back logos are faintly visible
            const backMaterial = createGlobeMaterial(0.1, THREE.BackSide, false);
            const frontMaterial = createGlobeMaterial(0.72, THREE.FrontSide, true);
            
            // Store both materials so we can update uniforms in sync
            window.globeMaterials = [ backMaterial, frontMaterial ];
            
            const globeBack = new THREE.Mesh(geometry, backMaterial);
            const globeFront = new THREE.Mesh(geometry, frontMaterial);
            globe = new THREE.Group();
            globe.add(globeBack);
            globe.add(globeFront);
    
            try {
                scene.add(globe);
        
                // Add subtle lighting
                const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
                scene.add(ambientLight);
                
                const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
                directionalLight.position.set(5, 5, 5);
                scene.add(directionalLight);
                
                // Setup raycaster for detecting clicks on globe
                raycaster = new THREE.Raycaster();
                
                // Set initial camera position for better view
                camera.position.set(0, 0, 5);
                camera.lookAt(0, 0, 0);
                
                // Reset rotation state
                globeRotation = { x: 0, y: 0 };
                rotationVelocity = { x: 0, y: 0 };
                isDragging = false;
                autoRotateEnabled = true;
                
                // Render initial frame to ensure globe appears immediately
                requestAnimationFrame(() => {
                    renderer.render(scene, camera);
                });
                
                console.log('CTAB: Globe initialized successfully', { width, height, container: container.offsetWidth + 'x' + container.offsetHeight });
                
                /* ResizeObserver: keep canvas in sync when container size changes (fluid responsive CSS) */
                try {
                    const ro = new ResizeObserver(() => {
                        const w = container.offsetWidth;
                        const h = container.offsetHeight;
                        if (w > 0 && h > 0 && camera && renderer) {
                            camera.aspect = w / h;
                            camera.updateProjectionMatrix();
                            renderer.setSize(w, h);
                        }
                    });
                    ro.observe(container);
                } catch (e) {}
            } catch (error) {
                console.error('CTAB: Error initializing globe:', error);
                // Remove initialization flag so it can retry
                container.removeAttribute('data-globe-initialized');
                // Clear container for retry
                container.innerHTML = '';
            }
            
            let lastMousePos = { x: 0, y: 0 };
            
            // Function to check if click is on globe
            function checkGlobeIntersection(event) {
                const rect = renderer.domElement.getBoundingClientRect();
                const mouse = new THREE.Vector2();
                const clientX = event.clientX !== undefined ? event.clientX : event.pageX;
                const clientY = event.clientY !== undefined ? event.clientY : event.pageY;
                mouse.x = ((clientX - rect.left) / rect.width) * 2 - 1;
                mouse.y = -((clientY - rect.top) / rect.height) * 2 + 1;
                
                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObject(globe, true);
                return intersects.length > 0;
            }
            
            // Get parent layer for cursor management
            const parentLayer = container.closest('.layer-1');
            let isHoveringGlobe = false;
            let dragResumeTimeout = null;
            
            // Get mouse position from event (supports both mouse and touch)
            function getMousePosition(event) {
                if (event.touches && event.touches.length > 0) {
                    return { x: event.touches[0].clientX, y: event.touches[0].clientY };
                }
                return { x: event.clientX, y: event.clientY };
            }
            
            // Handle mouse down - start dragging
            function handleMouseDown(event) {
                const isOnGlobe = checkGlobeIntersection(event);
                if (isOnGlobe) {
                    event.preventDefault();
                    isDragging = true;
                    autoRotateEnabled = false;
                    
                    const pos = getMousePosition(event);
                    lastMousePos = pos;
                    
                    // Stop any momentum
                    rotationVelocity.x = 0;
                    rotationVelocity.y = 0;
                    
                    // Update shader
                    (window.globeMaterials || []).forEach(function (mat) {
                        if (mat && mat.uniforms) mat.uniforms.isDragging.value = 1;
                    });
                    
                    // Update cursor
                    if (parentLayer) parentLayer.style.cursor = 'grabbing';
                    renderer.domElement.style.cursor = 'grabbing';
                    
                    // Clear auto-rotate resume timeout
                    if (dragResumeTimeout) {
                        clearTimeout(dragResumeTimeout);
                        dragResumeTimeout = null;
                    }
                }
            }
            
            // Handle mouse move - rotate globe
            function handleMouseMove(event) {
                if (isDragging) {
                    event.preventDefault();
                    const pos = getMousePosition(event);
                    
                    // Calculate mouse movement delta
                    const deltaX = pos.x - lastMousePos.x;
                    const deltaY = pos.y - lastMousePos.y;
                    
                    // Only allow horizontal (left/right) rotation - ignore vertical movement
                    const rotationDeltaY = -deltaX * rotationSensitivity;
                    
                    // Apply rotation only on Y axis (horizontal rotation)
                    globeRotation.y += rotationDeltaY;
                    
                    // Store velocity for momentum (only Y axis)
                    rotationVelocity.x = 0; // Keep X velocity at 0
                    rotationVelocity.y = rotationDeltaY;
                    
                    // Apply rotation to globe - keep X rotation fixed
                    globe.rotation.x = globeRotation.x; // Keep X rotation unchanged
                    globe.rotation.y = globeRotation.y;
                    
                    lastMousePos = pos;
                } else {
                    // Check hover state for cursor
                    const isOnGlobe = checkGlobeIntersection(event);
                    isHoveringGlobe = isOnGlobe;
                    
                    if (isOnGlobe) {
                        if (parentLayer) parentLayer.style.cursor = 'grab';
                        renderer.domElement.style.cursor = 'grab';
                    } else {
                        if (parentLayer) parentLayer.style.cursor = 'default';
                        renderer.domElement.style.cursor = 'default';
                    }
                }
            }
            
            // Handle mouse up - stop dragging and apply momentum
            function handleMouseUp() {
                if (isDragging) {
                    isDragging = false;
                    
                    // Update cursor
                    if (parentLayer) parentLayer.style.cursor = isHoveringGlobe ? 'grab' : 'default';
                    renderer.domElement.style.cursor = isHoveringGlobe ? 'grab' : 'default';
                    
                    // Resume auto-rotation after momentum settles
                    dragResumeTimeout = setTimeout(() => {
                        autoRotateEnabled = true;
                        (window.globeMaterials || []).forEach(function (mat) {
                            if (mat && mat.uniforms) mat.uniforms.isDragging.value = 0;
                        });
                    }, 800);
                }
            }
            
            // Mouse events
            renderer.domElement.addEventListener('mousedown', handleMouseDown);
            document.addEventListener('mousemove', handleMouseMove);
            document.addEventListener('mouseup', handleMouseUp);
            
            // Touch events
            renderer.domElement.addEventListener('touchstart', (event) => {
                if (event.touches.length === 1) {
                    handleMouseDown(event);
                }
            }, { passive: false });
            
            renderer.domElement.addEventListener('touchmove', (event) => {
                if (event.touches.length === 1 && isDragging) {
                    handleMouseMove(event);
                }
            }, { passive: false });
            
            renderer.domElement.addEventListener('touchend', handleMouseUp);
            renderer.domElement.addEventListener('touchcancel', handleMouseUp);
            
            // Handle mouse leave
            renderer.domElement.addEventListener('mouseleave', () => {
                if (isDragging) {
                    handleMouseUp();
                }
                isHoveringGlobe = false;
                if (parentLayer) parentLayer.style.cursor = 'default';
                renderer.domElement.style.cursor = 'default';
            });
        }
    
        let lastFrameTime = performance.now();
    
        function animate() {
            requestAnimationFrame(animate);
    
            // Only animate if globe is initialized
            if (globe && scene && camera && renderer) {
                // Calculate delta time for frame-rate independent animation
                const currentTime = performance.now();
                const deltaTime = Math.min((currentTime - lastFrameTime) / 1000, 0.1); // Cap at 100ms
                lastFrameTime = currentTime;
                
                // Apply momentum when not dragging
                if (!isDragging) {
                    // Only apply Y rotation velocity (horizontal rotation only)
                    globeRotation.y += rotationVelocity.y;
                    
                    // Apply damping to velocity (creates smooth deceleration)
                    rotationVelocity.x = 0; // Keep X velocity at 0
                    rotationVelocity.y *= rotationDamping;
                    
                    // Stop very small velocities to prevent infinite rotation
                    if (Math.abs(rotationVelocity.y) < 0.001) rotationVelocity.y = 0;
                    
                    // Auto-rotate when enabled and no user interaction
                    if (autoRotateEnabled && rotationVelocity.y === 0) {
                        globeRotation.y -= autoRotateSpeed * deltaTime;
                    }
                    
                    // Apply rotation to globe - keep X rotation fixed
                    globe.rotation.x = globeRotation.x; // Keep X rotation unchanged
                    globe.rotation.y = globeRotation.y;
                }
    
                // Update shader uniforms
                (window.globeMaterials || []).forEach(function (mat) {
                    if (!mat || !mat.uniforms) return;
                    mat.uniforms.globeRotationY.value = globeRotation.y;
                    if (autoRotateEnabled && !isDragging && rotationVelocity.x === 0 && rotationVelocity.y === 0) {
                        mat.uniforms.time.value += deltaTime * 0.3;
                    }
                });
    
                renderer.render(scene, camera);
            }
        }
    
        // Handle window resize - scoped to prevent conflicts
        window.addEventListener('resize', () => {
            const frameContainer = document.querySelector('.frame-2147227567');
            if (!frameContainer) return;
            const container = frameContainer.querySelector('#globe-container');
            if (!container || !camera || !renderer) return;
            
            let width = container.offsetWidth;
            let height = container.offsetHeight;
            
            // Handle zero dimensions in mobile
            if (width === 0 || height === 0) {
                const computedStyle = window.getComputedStyle(container);
                width = parseFloat(computedStyle.width) || 500;
                height = parseFloat(computedStyle.height) || 500;
                
                if (width === 0 || height === 0) {
                    const isMobile = window.innerWidth <= 768;
                    width = isMobile ? 540 : 820;
                    height = isMobile ? 540 : 820;
                }
                
                container.style.width = width + 'px';
                container.style.height = height + 'px';
            }
            
            if (width > 0 && height > 0) {
                camera.aspect = width / height;
                camera.updateProjectionMatrix();
                renderer.setSize(width, height);
            }
        });
    
        // Counter Animation
        function animateCounter(element) {
            const target = parseFloat(element.getAttribute('data-target'));
            const suffix = element.getAttribute('data-suffix') || '';
            const duration = 2000; // 2 seconds
            const startTime = performance.now();
            const isDecimal = target % 1 !== 0;
    
            function updateCounter(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // Easing function (ease-out)
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = target * easeOut;
    
                if (isDecimal) {
                    element.textContent = current.toFixed(1) + suffix;
                } else {
                    const displayValue = Math.floor(current);
                    element.textContent = displayValue + suffix;
                }
    
                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                } else {
                    // Ensure final value is exact
                    const finalValue = isDecimal ? target.toFixed(1) : Math.floor(target);
                    element.textContent = finalValue + suffix;
                }
            }
    
            requestAnimationFrame(updateCounter);
        }
    
        // Intersection Observer for counter animation
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px'
        };
    
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const counter = entry.target;
                    if (!counter.classList.contains('animated')) {
                        counter.classList.add('animated');
                        animateCounter(counter);
                    }
                }
            });
        }, observerOptions);
    
        // Start animation loop immediately
        animate();
  
        // Initialize when DOM is ready - scoped to prevent conflicts
        function initialize() {
            // Scope to .frame-2147227567 container
            const frameContainer = document.querySelector('.frame-2147227567');
            if (!frameContainer) {
                console.warn('CTAB: frameContainer not found during initialization');
                return;
            }
            
            // Wait a bit for styles to apply, especially important for mobile
            // This ensures container dimensions are calculated correctly
            setTimeout(() => {
                // Initialize globe
                initGlobe();
                
                // If globe still didn't initialize, try again after a short delay
                // This handles cases where mobile styles haven't applied yet
                if (!globe || !renderer) {
                    setTimeout(() => {
                        initGlobe();
                    }, 100);
                }
            }, 50);
    
            // Setup counter observers - only within this component
            frameContainer.querySelectorAll('.counter-number').forEach(counter => {
                observer.observe(counter);
            });
        }
    
        // Check if DOM is already loaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initialize);
        } else {
            // DOM is already loaded
            initialize();
        }
        
        // Also try initialization on window load (ensures all styles are applied)
        window.addEventListener('load', () => {
            const frameContainer = document.querySelector('.frame-2147227567');
            if (frameContainer && (!globe || !renderer)) {
                setTimeout(() => {
                    initGlobe();
                }, 100);
            }
        });
        
        // Use IntersectionObserver to initialize globe when it becomes visible (important for mobile)
        const globeObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && (!globe || !renderer)) {
                    // Globe container is visible, initialize if not already done
                    console.log('CTAB: Globe container is visible, initializing...');
                    setTimeout(() => {
                        initGlobe();
                    }, 50);
                }
            });
        }, {
            threshold: 0.01, // Trigger even if just 1% visible
            rootMargin: '100px' // Start loading before it's fully visible
        });
        
        // Observe the globe container when it's available - try multiple times
        function observeGlobeContainer() {
            const frameContainer = document.querySelector('.frame-2147227567');
            if (frameContainer) {
                const container = frameContainer.querySelector('#globe-container');
                if (container) {
                    globeObserver.observe(container);
                    console.log('CTAB: Globe container observer attached');
                    return true;
                }
            }
            return false;
        }
        
        // Try to observe immediately and on delays
        setTimeout(() => {
            if (!observeGlobeContainer()) {
                // Retry if not found
                setTimeout(() => observeGlobeContainer(), 500);
            }
        }, 100);
        
        // Also try on window load
        window.addEventListener('load', () => {
            setTimeout(() => observeGlobeContainer(), 100);
        });

        // Retry when widget HTML is injected after DOM ready (WordPress / Elementor blocks)
        (function retryLateInject() {
            var attempts = 0;
            var timer = setInterval(function() {
                if (globe && renderer) {
                    clearInterval(timer);
                    return;
                }
                var frameContainer = document.querySelector('.frame-2147227567');
                if (frameContainer) {
                    initGlobe();
                    observeGlobeContainer();
                }
                if (++attempts > 40) {
                    clearInterval(timer);
                }
            }, 250);
        })();
  </script>
