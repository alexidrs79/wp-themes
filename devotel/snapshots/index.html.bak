			color: #cad5e2 !important;
			text-decoration: underline !important;
		}
		
		/* Desktop: align bottom section (copyright row) with Communication APIs column */
		@media (min-width: 769px) {
			#devotel-footer-wrapper > div:last-child {
				padding-left: 100px !important;
				padding-right: 100px !important;
			}
			#devotel-footer-wrapper > div:last-child > div {
				align-items: flex-start !important;
				justify-content: flex-start !important;
				width: 100% !important;
				max-width: 1280px !important;
			}
		}
		
		/* Prevent footer from being affected by Elementor global styles */
		#devotel-footer-wrapper {
			/* Reset any potential Elementor global styles */
			margin: 0 !important;
			padding: 0 !important;
		}
		
		/* Ensure no style inheritance from parent to footer */
		#devotel-footer-wrapper * {
			/* Prevent inheritance of Elementor styles */
			font-family: inherit;
		}
		
		/* Final protection: Ensure blog content is completely isolated */
		body:not(#devotel-footer-wrapper) #asd,
		body:not(#devotel-footer-wrapper) .elementor-element-ffb1353 {
			isolation: isolate;
			contain: layout style;
  }
      </style>
	<script>
		// Masonry layout for footer navigation links on mobile
		(function() {
			let isInitialized = false;
			
			function initFooterMasonry() {
				const footerWrapper = document.getElementById('devotel-footer-wrapper');
				if (!footerWrapper) {
					console.log('Footer wrapper not found');
					return;
				}
				
				// Try multiple selectors to find the navigation links container
				let navLinksContainer = footerWrapper.querySelector('div:first-child > div > div > div:last-child');
				if (!navLinksContainer) {
					// Alternative selector
					const topSection = footerWrapper.querySelector('div:first-child');
					if (topSection) {
						const innerDivs = topSection.querySelectorAll('div > div > div');
						if (innerDivs.length > 0) {
							navLinksContainer = innerDivs[innerDivs.length - 1];
						}
					}
				}
				
				if (!navLinksContainer) {
					console.log('Navigation links container not found');
					return;
				}
				
				// Check if we're on mobile
				const isMobile = window.matchMedia('(max-width: 768px)').matches;
				
				// Check if already initialized
				if (navLinksContainer.classList.contains('masonry-initialized')) {
					if (!isMobile) {
						// Restore original layout on desktop
						const leftCol = navLinksContainer.querySelector('.masonry-left-col');
						const rightCol = navLinksContainer.querySelector('.masonry-right-col');
						if (leftCol && rightCol) {
							// Move items back to original positions
							const allItems = [...leftCol.children, ...rightCol.children];
							navLinksContainer.innerHTML = '';
							navLinksContainer.classList.remove('masonry-initialized');
							// Restore original order: 1,2,3,4,5,6
							const originalOrder = [0, 1, 0, 1, 0, 1]; // 0=left, 1=right
							allItems.forEach((item, index) => {
								navLinksContainer.appendChild(item);
							});
							// Reorganize based on original indices
							const items = Array.from(navLinksContainer.children);
							if (items.length >= 6) {
								const reordered = [
									items.find(el => el.textContent.includes('Communication APIs')),
									items.find(el => el.textContent.includes('Application')),
									// items.find(el => el.textContent.includes('Connectivity')), // HIDDEN FOR NOW
									items.find(el => el.textContent.includes('Telco')),
									items.find(el => el.textContent.includes('Resources')), // Links to blog for now
									items.find(el => el.textContent.includes('Company'))
								].filter(Boolean);
								navLinksContainer.innerHTML = '';
								reordered.forEach(item => navLinksContainer.appendChild(item));
							}
						}
					}
					return;
				}
				
				if (isMobile) {
					// Get all navigation link divs
					const links = Array.from(navLinksContainer.children);
					if (links.length < 6) return;
					
					// Store original order for restoration
					links.forEach((link, index) => {
						link.setAttribute('data-original-index', index);
					});
					
					// Create two column containers
					const leftColumn = document.createElement('div');
					leftColumn.className = 'masonry-left-col';
					leftColumn.style.cssText = 'display: flex; flex-direction: column; gap: 32px; flex: 1 1 0; min-width: 0; width: 100%;';
					
					const rightColumn = document.createElement('div');
					rightColumn.className = 'masonry-right-col';
					rightColumn.style.cssText = 'display: flex; flex-direction: column; gap: 32px; flex: 1 1 0; min-width: 0; width: 100%;';
					
					// Add CSS to ensure exact 32px gap
					if (!document.getElementById('masonry-gap-style')) {
						const style = document.createElement('style');
						style.id = 'masonry-gap-style';
						style.textContent = `
		@media (max-width: 768px) {
								#devotel-footer-wrapper .masonry-right-col {
									gap: 32px !important;
								}
								#devotel-footer-wrapper .masonry-right-col > div {
									margin-bottom: 0 !important;
									margin-top: 0 !important;
								}
							}
						`;
						document.head.appendChild(style);
					}
					
					// Left column: Communication APIs (1), Connectivity (3 - HIDDEN), Resources (5 - now Blog)
					if (links[0]) {
						const item = links[0].cloneNode(true);
						item.style.marginBottom = '0';
						item.style.marginTop = '0';
						leftColumn.appendChild(item);
					}
					if (links[2]) {
						const item = links[2].cloneNode(true);
						item.style.marginBottom = '0';
						item.style.marginTop = '0';
						leftColumn.appendChild(item);
					}
					if (links[4]) {
						const item = links[4].cloneNode(true);
						item.style.marginBottom = '0';
						item.style.marginTop = '0';
						leftColumn.appendChild(item);
					}
					
					// Right column: Application (2), Telco (4), Company (6)
					if (links[1]) {
						const appItem = links[1].cloneNode(true);
						appItem.style.marginBottom = '0';
						appItem.style.marginTop = '0';
						rightColumn.appendChild(appItem);
					}
					if (links[3]) {
						const telcoItem = links[3].cloneNode(true);
						telcoItem.style.marginBottom = '0';
						telcoItem.style.marginTop = '0';
						rightColumn.appendChild(telcoItem);
					}
					if (links[5]) {
						const companyItem = links[5].cloneNode(true);
						companyItem.style.marginBottom = '0';
						companyItem.style.marginTop = '0';
						rightColumn.appendChild(companyItem);
					}
					
					// Clear container and add columns
					navLinksContainer.innerHTML = '';
					navLinksContainer.style.cssText = 'display: flex !important; flex-direction: row !important; gap: 23px !important; width: 100% !important; order: 4 !important; align-items: flex-start !important; min-width: 0 !important;';
					navLinksContainer.classList.add('masonry-initialized');
					navLinksContainer.appendChild(leftColumn);
					navLinksContainer.appendChild(rightColumn);
					
					isInitialized = true;
				}
			}
			
			// Run on load
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function() {
					setTimeout(initFooterMasonry, 100);
				});
			} else {
				setTimeout(initFooterMasonry, 100);
			}
			
			// Also run after a short delay to ensure DOM is ready
			setTimeout(initFooterMasonry, 500);
			
			// Handle resize
			let resizeTimer;
			window.addEventListener('resize', function() {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(function() {
					const isMobile = window.matchMedia('(max-width: 768px)').matches;
					const navLinksContainer = document.querySelector('#devotel-footer-wrapper div:first-child > div > div > div:last-child');
					if (navLinksContainer) {
						if (isMobile && !navLinksContainer.classList.contains('masonry-initialized')) {
							initFooterMasonry();
						} else if (!isMobile && navLinksContainer.classList.contains('masonry-initialized')) {
							// Reload to restore original layout
							location.reload();
						}
					}
				}, 250);
			});
		})();
	</script>
	<style>
		/* FINAL FIX: Maximum specificity to prevent ALL conflicts */
		/* This ensures blog content is completely protected from footer styles */
		body #asd.elementor-element.elementor-element-ffb1353.elementor-widget.elementor-widget-theme-post-content,
		body div#asd.elementor-element.elementor-element-ffb1353,
		body .elementor-element-ffb1353#asd,
		body [data-id="ffb1353"][id="asd"] {
			/* Complete isolation - highest specificity */
			isolation: isolate !important;
			contain: layout style paint !important;
			position: relative !important;
			z-index: auto !important;
			box-sizing: border-box !important;
			
			/* Prevent Tailwind/footer style interference */
			margin: revert !important;
			padding: revert !important;
			background: revert !important;
			/* NO color, font-family, or font-size - let Elementor control all fonts and colors */
			line-height: revert !important;
			width: revert !important;
			height: revert !important;
			display: revert !important;
		}
		
		/* CRITICAL: Protect all text elements with maximum specificity */
		body #asd.elementor-element.elementor-element-ffb1353 p,
		body #asd.elementor-element.elementor-element-ffb1353 .wp-block-paragraph,
		body .elementor-element-ffb1353#asd p {
			margin: 1em 0 !important;
			padding: 0 !important;
			line-height: 1.6 !important;
			/* Removed font-size and color to allow Elementor to control them */
			font-family: inherit !important;
			font-weight: 400 !important;
			text-align: left !important;
		}
		
		body #asd.elementor-element.elementor-element-ffb1353 h1,
		body #asd.elementor-element.elementor-element-ffb1353 h2,
		body #asd.elementor-element.elementor-element-ffb1353 h3,
		body #asd.elementor-element.elementor-element-ffb1353 h4,
		body #asd.elementor-element.elementor-element-ffb1353 h5,
		body #asd.elementor-element.elementor-element-ffb1353 h6,
		body #asd.elementor-element.elementor-element-ffb1353 .wp-block-heading {
			margin: 1.5em 0 0.5em 0 !important;
			padding: 0 !important;
			line-height: 1.2 !important;
			/* NO font-weight, font-family, font-size, or color - let Elementor control all fonts and colors */
		}
		
		body #asd.elementor-element.elementor-element-ffb1353 ul,
		body #asd.elementor-element.elementor-element-ffb1353 ol,
		body #asd.elementor-element.elementor-element-ffb1353 .wp-block-list {
			margin: 1em 0 !important;
			padding-left: 2em !important;
			list-style-position: outside !important;
		}
		
		body #asd.elementor-element.elementor-element-ffb1353 li {
			margin: 0.5em 0 !important;
			padding: 0 !important;
			line-height: 1.6 !important;
		}
		
		body #asd.elementor-element.elementor-element-ffb1353 a {
			/* Removed color to allow Elementor to control it */
			text-decoration: underline !important;
		}
		
		body #asd.elementor-element.elementor-element-ffb1353 img,
		body #asd.elementor-element.elementor-element-ffb1353 figure {
			margin: 1em 0 !important;
			padding: 0 !important;
			max-width: 100% !important;
			height: auto !important;
		}
		
		/* Ensure footer NEVER affects blog content */
		#devotel-footer-wrapper {
			contain: layout style paint !important;
		}
		
		/* Prevent any selector from targeting blog content through footer */
		#devotel-footer-wrapper #asd,
		#devotel-footer-wrapper .elementor-element-ffb1353 {
			/* If blog content somehow ends up in footer, reset it completely */
			all: revert !important;
		}
		
		/* Removed all heading/title color and font overrides - let Elementor control everything */
</style>
</head>
