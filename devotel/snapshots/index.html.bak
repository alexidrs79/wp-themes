					<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="initial-scale=1, width=device-width">
	<title>CTA Button</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	<style>
		:root {
			--ctab-padding-lg: 15px;
		}
		.ctab-btn,
		.ctab-btn:hover,
		.ctab-btn:active,
		.ctab-btn:focus {
			background-color: #325fec !important;
			color: #fff !important;
			border: none !important;
		}
		.ctab-btn {
			border-radius: 10px;
			display: inline-flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			padding: 0 var(--ctab-padding-lg, 15px);
			width: 146px;
			height: 40px;
			box-sizing: border-box;
			font-family: 'Inter', sans-serif;
			font-size: 16px;
			cursor: pointer;
			overflow: hidden;
			transition: width 0.3s ease, background-color 0.3s ease;
		}
		.ctab-btn:hover {
			background-color: #1e4fd9 !important;
			width: 170px;
		}
		.ctab-content {
			height: 40px;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 4px;
		}
		.ctab-label {
			line-height: 24px;
			font-weight: 500;
			transition: transform 0.3s ease;
		}
		.ctab-btn:hover .ctab-label {
			transform: translateX(-6px);
		}
		.ctab-icon {
			height: 20px;
			width: 0;
			opacity: 0;
			flex-shrink: 0;
			transform: translateX(-8px);
			transition: width 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
			overflow: hidden;
		}
		.ctab-btn:hover .ctab-icon {
			width: 20px;
			opacity: 1;
			transform: translateX(0);
		}
		.ctab-btn:focus {
			outline: none;
		}
		.ctab-btn {
			text-decoration: none;
		}
		@media (max-width: 768px) {
			.ctab-btn {
				width: 100% !important;
				display: flex;
				align-self: stretch;
			}
			.ctab-btn:hover {
				width: 100% !important;
			}
		}
	</style>
</head>
<body>
	<a class="ctab-btn" href="https://devotel.com/blog/">
		<div class="ctab-content">
			<span class="ctab-label">View all posts</span>
			<svg class="ctab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
				<path d="M4.16406 10H15.8307" stroke="currentColor" stroke-width="1.66566" stroke-linecap="round" stroke-linejoin="round"/>
				<path d="M10 4.16699L15.8333 10.0003L10 15.8337" stroke="currentColor" stroke-width="1.66566" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</div>
	</a>
</body>
</html>
