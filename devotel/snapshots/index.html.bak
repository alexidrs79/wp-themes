    </div>

    <script>
        // Custom dropdown for phone country code — supports multiple `.final-cta-form-wrapper` on one page
        (function() {
            'use strict';

            function fcta7cfCloseAllCountryDropdowns() {
                document.querySelectorAll('.final-cta-form-wrapper .custom-country-dropdown').forEach(function (dropdown) {
                    dropdown.classList.remove('open');
                    var prev = dropdown.previousElementSibling;
                    if (prev) prev.setAttribute('aria-expanded', 'false');
                });
            }

            function fcta7cfResolveFormFromWpcf7Event(event) {
                var t = event.target;
                if (t && t.nodeType === 1 && t.classList && t.classList.contains('wpcf7-form')) {
                    return t;
                }
                if (t && t.nodeType === 1) {
                    var w = t.classList && t.classList.contains('wpcf7') ? t : (t.closest ? t.closest('.wpcf7') : null);
                    if (w) {
                        var f = w.querySelector('form.wpcf7-form');
                        if (f) return f;
                    }
                    if (t.closest) {
                        var f2 = t.closest('form.wpcf7-form');
                        if (f2) return f2;
                    }
                }
                var tag = event.detail && event.detail.unitTag;
                if (tag) {
                    var root = document.getElementById(tag);
                    if (root && root.querySelector) {
                        var f3 = root.querySelector('form.wpcf7-form');
                        if (f3) return f3;
                    }
                }
                return null;
            }

            function fcta7cfFindResponseOutput(form) {
                if (!form) return null;
                var o = form.querySelector('.wpcf7-response-output');
                if (o) return o;
                var wrap = form.closest ? form.closest('.wpcf7') : null;
                return wrap && wrap.querySelector ? wrap.querySelector('.wpcf7-response-output') : null;
            }

            function showCf7CustomSuccess(form) {
                if (!form || !form.classList || !form.classList.contains('wpcf7-form')) return;
                var fields = form.querySelector('.fcta7cf-fields');
                var success = form.querySelector('.fcta7cf-sent');
                if (!fields || !success) return;

                var wpcf7root = form.closest('.wpcf7');
                if (wpcf7root) wpcf7root.classList.add('fcta7cf-wp7-sentouter');

                form.classList.add('fcta7cf-wp7-sentview');
                fields.hidden = true;
                fields.setAttribute('aria-hidden', 'true');
                success.hidden = false;
                success.removeAttribute('hidden');
                success.setAttribute('aria-hidden', 'false');

                var out = fcta7cfFindResponseOutput(form);
                if (out) {
                    out.setAttribute('hidden', '');
                    out.setAttribute('aria-hidden', 'true');
                    out.style.display = 'none';
                }
            }

            function hideCf7CustomSuccess(form) {
                if (!form) return;
                var fields = form.querySelector('.fcta7cf-fields');
                var success = form.querySelector('.fcta7cf-sent');
                if (!fields || !success) return;

                var wpcf7root = form.closest('.wpcf7');
                if (wpcf7root) wpcf7root.classList.remove('fcta7cf-wp7-sentouter');

                form.classList.remove('fcta7cf-wp7-sentview');
                success.hidden = true;
                success.setAttribute('aria-hidden', 'true');
                fields.hidden = false;
                fields.removeAttribute('hidden');
                fields.setAttribute('aria-hidden', 'false');

                var out = fcta7cfFindResponseOutput(form);
                if (out) {
                    out.removeAttribute('hidden');
                    out.removeAttribute('aria-hidden');
                    out.style.display = '';
                }
            }

            var fcta7cfDocumentListenersBound = false;
            function fcta7cfBindDocumentListenersOnce() {
                if (fcta7cfDocumentListenersBound) return;
                fcta7cfDocumentListenersBound = true;
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.final-cta-form-wrapper .custom-country-select')) {
                        fcta7cfCloseAllCountryDropdowns();
                    }
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') fcta7cfCloseAllCountryDropdowns();
                });
                document.addEventListener('wpcf7mailsent', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest || !form.closest('.final-cta-form-wrapper')) return;
                    showCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7invalid', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7spam', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7mailfailed', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
            }

            function bootFinalCtaFormWrappers() {
                var wrappers = document.querySelectorAll('.final-cta-form-wrapper');
                if (!wrappers.length) return;
                fcta7cfBindDocumentListenersOnce();

                wrappers.forEach(function (formWrapper) {
                    if (formWrapper.dataset.fcta7cfInitialized === '1') return;
                    formWrapper.dataset.fcta7cfInitialized = '1';

            // Country code to flag mapping
            function getCountryFlagClass(countryCode) {
                const flagMap = {
                    'GB': 'fi-gb', 'US': 'fi-us', 'UAE': 'fi-ae', 'FR': 'fi-fr', 'DE': 'fi-de',
                    'IT': 'fi-it', 'ES': 'fi-es', 'NL': 'fi-nl', 'BE': 'fi-be', 'CH': 'fi-ch',
                    'AT': 'fi-at', 'SE': 'fi-se', 'NO': 'fi-no', 'DK': 'fi-dk', 'FI': 'fi-fi',
                    'PL': 'fi-pl', 'CZ': 'fi-cz', 'IE': 'fi-ie', 'PT': 'fi-pt', 'GR': 'fi-gr',
                    'AU': 'fi-au', 'CA': 'fi-ca', 'NZ': 'fi-nz', 'JP': 'fi-jp', 'KR': 'fi-kr',
                    'CN': 'fi-cn', 'IN': 'fi-in', 'SG': 'fi-sg', 'MY': 'fi-my', 'TH': 'fi-th',
                    'PH': 'fi-ph', 'ID': 'fi-id', 'VN': 'fi-vn', 'BR': 'fi-br', 'MX': 'fi-mx',
                    'AR': 'fi-ar', 'CL': 'fi-cl', 'CO': 'fi-co', 'ZA': 'fi-za', 'EG': 'fi-eg',
                    'SA': 'fi-sa', 'IL': 'fi-il', 'TR': 'fi-tr', 'RU': 'fi-ru'
                };
                return flagMap[countryCode] || 'fi-xx';
            }
            
            function createFlagElement(countryCode) {
                const flagSpan = document.createElement('span');
                flagSpan.className = `fi ${getCountryFlagClass(countryCode)} country-flag`;
                return flagSpan;
            }
            
            function initCustomCountryDropdown() {
                const selects = formWrapper.querySelectorAll('.phone-country-code-wrapper select.phone-country-code, .wpcf7-select.phone-country-code');
            
            selects.forEach(select => {
                const wrapper = select.closest('.phone-country-code-wrapper');
                if (!wrapper) return;
                
                // Skip if already converted
                if (wrapper.querySelector('.custom-country-select')) {
                    return;
                }
                
                // Create custom dropdown structure
                const customSelect = document.createElement('div');
                customSelect.className = 'custom-country-select';
                
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'custom-country-select-button';
                button.setAttribute('aria-haspopup', 'listbox');
                button.setAttribute('aria-expanded', 'false');
                
                const dropdown = document.createElement('div');
                dropdown.className = 'custom-country-dropdown';
                dropdown.setAttribute('role', 'listbox');
                
                // Get current value
                const currentValue = select.value || select.options[0]?.value || '';
                const currentText = select.options[select.selectedIndex]?.text || select.options[0]?.text || '';
                
                // Set button content with flag
                const buttonFlag = createFlagElement(currentValue);
                const buttonText = document.createTextNode(currentValue);
                button.appendChild(buttonFlag);
                button.appendChild(buttonText);
                
                // Create options
                Array.from(select.options).forEach(option => {
                    const optionDiv = document.createElement('div');
                    optionDiv.className = 'custom-country-option';
                    if (option.value === currentValue) {
                        optionDiv.classList.add('selected');
                    }
                    
                    // Add flag
                    const optionFlag = createFlagElement(option.value);
                    optionDiv.appendChild(optionFlag);
                    
                    // Add country code text
                    const optionText = document.createTextNode(option.value);
                    optionDiv.appendChild(optionText);
                    
                    optionDiv.setAttribute('data-value', option.value);
                    optionDiv.setAttribute('role', 'option');
                    optionDiv.setAttribute('aria-selected', option.value === currentValue);
                    
                    optionDiv.addEventListener('click', () => {
                        select.value = option.value;
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                        
                        // Update button with new flag and text
                        button.innerHTML = '';
                        const newButtonFlag = createFlagElement(option.value);
                        const newButtonText = document.createTextNode(option.value);
                        button.appendChild(newButtonFlag);
                        button.appendChild(newButtonText);
                        
                        // Get existing arrow
                        const existingArrow = wrapper.querySelector('.phone-country-arrow');
                        if (existingArrow) {
                            const arrowClone = existingArrow.cloneNode(true);
                            button.appendChild(arrowClone);
                        }
                        
                        dropdown.querySelectorAll('.custom-country-option').forEach(opt => {
                            opt.classList.remove('selected');
                            opt.setAttribute('aria-selected', 'false');
                        });
                        optionDiv.classList.add('selected');
                        optionDiv.setAttribute('aria-selected', 'true');
                        dropdown.classList.remove('open');
                        button.setAttribute('aria-expanded', 'false');
                    });
                    
                    dropdown.appendChild(optionDiv);
                });
                
                // Toggle dropdown
                button.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = dropdown.classList.contains('open');
                    fcta7cfCloseAllCountryDropdowns();
                    if (!isOpen) {
                        dropdown.classList.add('open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
                
                // Get existing arrow
                const existingArrow = wrapper.querySelector('.phone-country-arrow');
                if (existingArrow) {
                    const arrowClone = existingArrow.cloneNode(true);
                    button.appendChild(arrowClone);
                } else {
                    // Create arrow if it doesn't exist
                    const arrow = document.createElement('svg');
                    arrow.className = 'phone-country-arrow';
                    arrow.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
                    arrow.setAttribute('width', '16');
                    arrow.setAttribute('height', '16');
                    arrow.setAttribute('viewBox', '0 0 16 16');
                    arrow.setAttribute('fill', 'none');
                    arrow.innerHTML = '<path d="M4 6L8 10L12 6" stroke="#A4A7AE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>';
                    button.appendChild(arrow);
                }
                
                customSelect.appendChild(button);
                customSelect.appendChild(dropdown);
                
                // Insert custom select before the native select
                wrapper.insertBefore(customSelect, select);
                
                // Hide native select but keep it for form submission
                select.classList.add('hidden-select');
            });
        }

            initCustomCountryDropdown();

            // Re-initialize when Contact Form 7 loads the form dynamically
            const countryDropdownObserver = new MutationObserver(() => {
                initCustomCountryDropdown();
            });

            countryDropdownObserver.observe(formWrapper, {
                childList: true,
                subtree: true
            });

            // Also try after a delay for CF7
            setTimeout(initCustomCountryDropdown, 500);
            setTimeout(initCustomCountryDropdown, 1000);
            setTimeout(initCustomCountryDropdown, 2000);
            
            // Fix privacy checkbox layout
            function fixPrivacyCheckbox() {
                const checkboxRows = formWrapper.querySelectorAll('p:has(input[type="checkbox"]), p:has([acceptance]), .form-checkbox-wrapper');
                checkboxRows.forEach(row => {
                    if (row) {
                        // Use inline-block method instead of flex
                        row.style.display = 'block';
                        row.style.fontSize = '0';
                        row.style.whiteSpace = 'nowrap';
                        row.style.paddingLeft = '0';
                        row.style.marginLeft = '0';
                        row.style.paddingRight = '0';
                        row.style.marginRight = '0';
                        row.style.textAlign = 'left';
                        row.style.width = '100%';
                        row.style.maxWidth = '100%';
                        row.style.boxSizing = 'border-box';
                        
                        // Make all children inline-block with no spacing
                        Array.from(row.children).forEach((child) => {
                            child.style.display = 'inline-block';
                            child.style.verticalAlign = 'middle';
                            child.style.margin = '0';
                            child.style.marginLeft = '0';
                            child.style.marginRight = '0';
                            child.style.padding = '0';
                            child.style.paddingLeft = '0';
                            child.style.paddingRight = '0';
                            child.style.fontSize = '16px';
                            
                            // If it's the checkbox input, add small right margin and styles
                            if (child.tagName === 'INPUT' && child.type === 'checkbox') {
                                child.style.marginRight = '8px';
                                child.style.marginLeft = '0';
                                child.style.marginTop = '0';
                                child.style.marginBottom = '0';
                                child.style.borderRadius = 'var(--spacing-sm, 6px)';
                                child.style.border = '1px solid var(--Border-border-primary, #CAD5E2)';
                            }
                            // If it's a span or wrapper containing checkbox
                            if (child.querySelector && child.querySelector('input[type="checkbox"]')) {
                                const checkbox = child.querySelector('input[type="checkbox"]');
                                if (checkbox) {
                                    checkbox.style.marginRight = '8px';
                                    checkbox.style.marginLeft = '0';
                                    checkbox.style.marginTop = '0';
                                    checkbox.style.marginBottom = '0';
                                    checkbox.style.borderRadius = 'var(--spacing-sm, 6px)';
                                    checkbox.style.border = '1px solid var(--Border-border-primary, #CAD5E2)';
                                }
                            }
                            // Labels
                            if (child.tagName === 'LABEL' || child.querySelector('label')) {
                                const label = child.tagName === 'LABEL' ? child : child.querySelector('label');
                                if (label) {
                                    label.style.display = 'inline-block';
                                    label.style.margin = '0';
                                    label.style.padding = '0';
                                    label.style.verticalAlign = 'middle';
                                }
                            }
                        });
                        
                        // Make all children inline
                        Array.from(row.children).forEach(child => {
                            if (child.tagName === 'LABEL' || child.tagName === 'SPAN') {
                                child.style.display = 'inline';
                                child.style.whiteSpace = 'nowrap';
                            }
                            // Remove any br tags
                            child.querySelectorAll('br').forEach(br => br.remove());
                        });
                    }
                });
            }
            
            // Replace iti-arrow with custom SVG
            function replaceItiArrow() {
                const itiArrows = formWrapper.querySelectorAll('.iti-arrow');
                itiArrows.forEach(arrow => {
                    // Skip if already replaced
                    if (arrow.querySelector('svg.custom-arrow-svg')) {
                        return;
                    }
                    
                    // Create SVG element
                    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
                    svg.setAttribute('width', '16');
                    svg.setAttribute('height', '16');
                    svg.setAttribute('viewBox', '0 0 16 16');
                    svg.setAttribute('fill', 'none');
                    svg.className = 'custom-arrow-svg';
                    
                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    path.setAttribute('d', 'M4 6L8 10L12 6');
                    path.setAttribute('stroke', '#A4A7AE');
                    path.setAttribute('stroke-width', '1.75');
                    path.setAttribute('stroke-linecap', 'round');
                    path.setAttribute('stroke-linejoin', 'round');
                    
                    svg.appendChild(path);
                    
                    // Replace arrow content
                    arrow.innerHTML = '';
                    arrow.appendChild(svg);
                    arrow.style.display = 'inline-block';
                    arrow.style.width = '16px';
                    arrow.style.height = '16px';
                });
            }
            
            // Run on load and after CF7 loads
            setTimeout(fixPrivacyCheckbox, 100);
            setTimeout(fixPrivacyCheckbox, 500);
            setTimeout(fixPrivacyCheckbox, 1000);
            setTimeout(fixPrivacyCheckbox, 2000);
            
            // Replace iti-arrow on load
            setTimeout(replaceItiArrow, 100);
            setTimeout(replaceItiArrow, 500);
            setTimeout(replaceItiArrow, 1000);
            setTimeout(replaceItiArrow, 2000);
            
            // Set default value for Topic dropdown
            function setTopicDefault() {
                const topicSelect = formWrapper.querySelector('select[name="topic"]');
                if (topicSelect) {
                    // Don't override if user has manually changed the value
                    if (topicSelect.hasAttribute('data-user-changed')) {
                        return;
                    }
                    
                    // Wait for options to be populated (CF7 might load them dynamically)
                    const options = Array.from(topicSelect.querySelectorAll('option'));
                    if (options.length === 0) {
                        // Options not loaded yet, try again later
                        return;
                    }
                    
                    // Find the option with text "Connectivity Management Platform (CMP)"
                    let foundDefault = false;
                    let defaultOption = null;
                    
                    options.forEach(option => {
                        const optionText = option.textContent.trim();
                        const optionValue = option.value.trim();
                        
                        // Check if this is the "Connectivity Management Platform (CMP)" option (match text or value)
                        if (optionText === 'Connectivity Management Platform (CMP)' || optionValue === 'Connectivity Management Platform (CMP)' || 
                            optionText.includes('Connectivity Management Platform (CMP)') || optionValue.includes('Connectivity Management Platform (CMP)')) {
                            defaultOption = option;
                            foundDefault = true;
                        }
                    });
                    
                    if (foundDefault && defaultOption) {
                        // Get the actual value to use
                        const optionValue = defaultOption.value.trim() || defaultOption.textContent.trim();
                        
                        // Only set if current value is not already "Connectivity Management Platform (CMP)"
                        const currentValue = topicSelect.value.trim();
                        const currentText = topicSelect.options[topicSelect.selectedIndex]?.textContent.trim();
                        
                        if (currentValue !== optionValue && currentText !== 'Connectivity Management Platform (CMP)') {
                            // Set the value directly
                            topicSelect.value = optionValue;
                            
                            // Also set selected attribute on all options
                            options.forEach(opt => opt.selected = false);
                            defaultOption.selected = true;
                            
                            // Mark as default set
                            topicSelect.setAttribute('data-default-set', 'true');
                            // Add has-value class for color styling
                            topicSelect.classList.add('has-value');
                            
                            // Use a small delay before triggering change to ensure value is set
                            setTimeout(() => {
                                topicSelect.dispatchEvent(new Event('change', { bubbles: true }));
                            }, 10);
                        } else if (currentText === 'Connectivity Management Platform (CMP)' || currentValue === optionValue) {
                            // Already set, just ensure classes are correct
                            topicSelect.setAttribute('data-default-set', 'true');
                            topicSelect.classList.add('has-value');
                        }
                    } else {
                        // If default was already set, just ensure has-value class is set
                        if (topicSelect.value && topicSelect.value !== '') {
                            topicSelect.classList.add('has-value');
                        }
                    }
                }
            }
            
            // Update select color when value changes
            function updateSelectColor() {
                const topicSelect = formWrapper.querySelector('select[name="topic"]');
                if (topicSelect && !topicSelect.hasAttribute('data-color-listener')) {
                    // Mark as having listener to avoid duplicates
                    topicSelect.setAttribute('data-color-listener', 'true');
                    
                    // Add change event listener
                    topicSelect.addEventListener('change', function() {
                        // Mark that user has manually changed the value
                        this.setAttribute('data-user-changed', 'true');
                        
                        if (this.value && this.value !== '') {
                            this.classList.add('has-value');
                        } else {
                            this.classList.remove('has-value');
                        }
                    });
                    
                    // Set initial state
                    if (topicSelect.value && topicSelect.value !== '') {
                        topicSelect.classList.add('has-value');
                    }
                }
            }
            
            // Run on load and after CF7 loads
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 100);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 500);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 1000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 2000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 3000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 5000);
            
            // Also watch for form changes
            const formObserver = new MutationObserver(() => {
                fixPrivacyCheckbox();
                replaceItiArrow();
                setTopicDefault();
                updateSelectColor();
            });
            formObserver.observe(formWrapper, {
                childList: true,
                subtree: true
            });

            function bindCf7SuccessUi(root) {
                if (!root) return;
                var scope = root;
                scope.querySelectorAll('form.wpcf7-form').forEach(function (cf7Form) {
                    if (cf7Form.dataset.fcta7cfSuccessBound === '1') return;
                    var successEl = cf7Form.querySelector('.fcta7cf-sent');
                    var btn = cf7Form.querySelector('.fcta7cf-sent-backbtn');
                    if (!successEl || !btn) return;
                    cf7Form.dataset.fcta7cfSuccessBound = '1';
                    btn.addEventListener('click', function () {
                        hideCf7CustomSuccess(cf7Form);
                        if (typeof wpcf7 !== 'undefined' && typeof wpcf7.reset === 'function') {
                            wpcf7.reset(cf7Form);
                        } else {
                            cf7Form.reset();
                        }
                        setTimeout(function () {
                            initCustomCountryDropdown();
                            fixPrivacyCheckbox();
                            replaceItiArrow();
                        }, 50);
                    });
                });
            }

            bindCf7SuccessUi(formWrapper);
            const successUiObserver = new MutationObserver(function () {
                bindCf7SuccessUi(formWrapper);
            });
            successUiObserver.observe(formWrapper, { childList: true, subtree: true });
            setTimeout(function () { bindCf7SuccessUi(formWrapper); }, 500);
            setTimeout(function () { bindCf7SuccessUi(formWrapper); }, 1500);

                }); /* end forEach wrapper */
            } /* end bootFinalCtaFormWrappers */

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bootFinalCtaFormWrappers);
            } else {
                bootFinalCtaFormWrappers();
            }
            setTimeout(bootFinalCtaFormWrappers, 800);
            setTimeout(bootFinalCtaFormWrappers, 2500);
        })();
    </script>
</body>
</html>

				</div>
				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-486716f e-con-full e-flex e-con e-parent" data-id="486716f" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-f9d9a8d elementor-invisible elementor-widget elementor-widget-html" data-id="f9d9a8d" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeIn&quot;}" data-widget_type="html.default">
					<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="initial-scale=1, width=device-width">
	<title>Devotel CTA Section</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"></noscript><style>.devotel-cta-button2,.devotel-cta-button2:hover,.devotel-cta-button2:active,.devotel-cta-button2:focus,.devotel-cta-button2:visited{background-color:#325fec !important;color:#fff !important;border-color:transparent !important;}.devotel-cta-button2 *,.devotel-cta-button2:hover *,.devotel-cta-button2:active *,.devotel-cta-button2:focus *{color:#fff !important;}.devotel-cta-button2[style*="#c94577"],.devotel-cta-button2[style*="rgb(201,69,119)"],.devotel-cta-button2:hover[style*="#c94577"],.devotel-cta-button2:active[style*="#c94577"]{background-color:#325fec !important;color:#fff !important;}.devotel-cta-try-it-for-free-wrapper,.devotel-cta-try-it-for-free-wrapper:hover,.devotel-cta-try-it-for-free-wrapper:active,.devotel-cta-try-it-for-free-wrapper:focus,.devotel-cta-try-it-for-free-wrapper:visited{background-color:transparent !important;color:#fff !important;border-color:#94bdfd !important;}.devotel-cta-try-it-for-free-wrapper *,.devotel-cta-try-it-for-free-wrapper:hover *,.devotel-cta-try-it-for-free-wrapper:active *,.devotel-cta-try-it-for-free-wrapper:focus *{color:#fff !important;}.devotel-cta-try-it-for-free-wrapper[style*="#c94577"],.devotel-cta-try-it-for-free-wrapper[style*="rgb(201,69,119)"],.devotel-cta-try-it-for-free-wrapper:hover[style*="#c94577"],.devotel-cta-try-it-for-free-wrapper:active[style*="#c94577"]{background-color:transparent !important;color:#fff !important;border-color:#94bdfd !important;}.devotel-cta-font-duplet{font-family:'Inter',sans-serif;font-weight:600;}*{transition-property:color,background-color,border-color,transform,opacity;transition-timing-function:cubic-bezier(0.4,0,0.2,1);transition-duration:300ms;}.devotel-cta-video-wrapper .devotel-cta-video-gradient-container video{z-index:2;mix-blend-mode:screen;}.devotel-cta-button{position:relative;display:flex;align-items:center;justify-content:center;gap:12px;text-align:center;font-size:16px;color:#fff;font-family:Inter;}:root{--devotel-cta-Components-Button-Component-paddingInlineLG:15px;}.devotel-cta-button2{border-radius:10px;background-color:#325fec;display:flex;flex-direction:row;align-items:center;justify-content:center;padding:0 var(--devotel-cta-Components-Button-Component-paddingInlineLG,15px);position:relative;overflow:hidden;cursor:pointer;width:186px;height:40px;box-sizing:border-box;text-align:center;}.devotel-cta-content{height:40px;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:4px;}.devotel-cta-talk-to-an{position:relative;line-height:24px;font-weight:500;padding:0;transition:transform 0.3s ease;text-align:center;}.devotel-cta-button2:hover .devotel-cta-talk-to-an{transform:translateX(-6px);}.devotel-cta-icon{height:20px;width:0;opacity:0;flex-shrink:0;transform:translateX(-8px);transition:width 0.3s ease,opacity 0.3s ease,transform 0.3s ease;overflow:hidden;}.devotel-cta-button2:hover .devotel-cta-icon{width:20px;opacity:1;transform:translateX(0);}.devotel-cta-button2:hover{background-color:#1e4fd9 !important;}.devotel-cta-button2:active{background-color:#325fec !important;}.devotel-cta-button2:focus{background-color:#325fec !important;outline:none !important;}.devotel-cta-button-secondary{background-color:transparent !important;border-radius:10px;border:1px solid var(--Border-border-primary,#CAD5E2) !important;border-color:var(--Border-border-primary,#CAD5E2) !important;width:158px !important;padding:0 var(--devotel-cta-Components-Button-Component-paddingInlineLG,15px) !important;height:40px !important;box-sizing:border-box !important;}.devotel-cta-button-secondary:hover{background-color:transparent !important;border-color:var(--Border-border-primary,#CAD5E2) !important;}.devotel-cta-button-secondary:active{background-color:transparent !important;border-color:var(--Border-border-primary,#CAD5E2) !important;}.devotel-cta-button-secondary:focus{background-color:transparent !important;border-color:var(--Border-border-primary,#CAD5E2) !important;outline:none !important;}.devotel-cta-content-wrapper h2,.devotel-cta-content-wrapper h2 *,.devotel-cta-content-wrapper h2:hover,.devotel-cta-content-wrapper h2:active,.devotel-cta-content-wrapper h2:focus,.devotel-cta-content-wrapper h2:visited{color:#fff !important;}.devotel-cta-content-wrapper h2[style*="#c94577"],.devotel-cta-content-wrapper h2[style*="rgb(201,69,119)"]{color:#fff !important;}.devotel-cta-video-wrapper{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:hidden;}.devotel-cta-video-wrapper-mobile{display:none;}.devotel-cta-video-wrapper .devotel-cta-video-gradient-container{position:absolute;inset:0;width:100%;height:100%;background:transparent;}.devotel-cta-video-wrapper .devotel-cta-video-gradient-container video{position:absolute;width:100%;height:100%;object-fit:contain;object-position:right center;right:0;top:50%;transform:translate(-25%,-50%) scale(1.6);}.devotel-cta-section{background:linear-gradient(153deg,#01050E 31.17%,#325FEC 145.63%),linear-gradient(94deg,#1E318A 0%,#266DF0 100%) !important;}.devotel-cta-section-container{max-width:1440px;width:100%;margin:0 auto;position:relative;height:100%;min-height:450px;}.devotel-cta-content-wrapper{position:absolute;top:50%;left:calc((100% - 1440px) / 2+80px);transform:translateY(-50%);width:647px;max-width:calc(100% - 160px);}@media (max-width:1440px){.devotel-cta-section-container{padding:0 24px;}.devotel-cta-content-wrapper{left:80px;}}@media (max-width:1024px){.devotel-cta-content-wrapper{left:40px;max-width:calc(100% - 80px);}}@media (max-width:768px){.devotel-cta-section{min-height:auto;padding-bottom:48px;background:linear-gradient(153deg,#01050E 31.17%,#325FEC 145.63%),linear-gradient(94deg,#1E318A 0%,#266DF0 100%) !important;}.devotel-cta-section-container{padding:48px 16px 0 16px;min-height:auto;height:auto;display:flex;flex-direction:column;gap:32px;align-items:center;justify-content:flex-start;position:relative;}.devotel-cta-video-wrapper{display:none;}.devotel-cta-video-wrapper-mobile{display:block;position:relative;width:100%;height:390px;order:4;flex-shrink:0;inset:auto;pointer-events:none;overflow:visible;}.devotel-cta-video-wrapper-mobile .devotel-cta-video-gradient-container{position:relative;width:100%;height:100%;inset:auto;background:transparent;}.devotel-cta-video-wrapper-mobile .devotel-cta-video-gradient-container video{position:relative;width:100%;height:100%;object-fit:contain;object-position:center center;right:auto;top:auto;transform:none;mix-blend-mode:screen;background-color:transparent;}.devotel-cta-content-wrapper{position:relative;top:auto;left:auto;transform:none;width:100%;max-width:100%;order:1;z-index:1;}.devotel-cta-content-wrapper>div{display:flex;flex-direction:column;gap:32px;align-items:flex-start;width:100%;}.devotel-cta-content-wrapper h2,.devotel-cta-content-wrapper h2.devotel-cta-font-duplet{color:var(--Text-text-white,#FFF) !important;font-family:'Duplet','Inter',sans-serif !important;font-size:var(--Font-Size-4xl,36px) !important;font-style:normal !important;font-weight:600 !important;line-height:44px !important;letter-spacing:-0.72px !important;order:1;width:100%;}.devotel-cta-content-wrapper h2.font-semibold{font-weight:600 !important;}.devotel-cta-content-wrapper p{order:2;width:100%;}.devotel-cta-content-wrapper .devotel-cta-button{flex-direction:column;gap:12px;width:100%;order:3;}.devotel-cta-content-wrapper .devotel-cta-button .devotel-cta-button2:first-child{width:100% !important;align-self:stretch;}.devotel-cta-content-wrapper .devotel-cta-button .devotel-cta-button-secondary{width:100% !important;align-self:stretch;}.devotel-cta-content-wrapper .devotel-cta-button .devotel-cta-button2{width:100% !important;}}.devotel-cta-section{position:relative;width:100%;min-height:450px;overflow:hidden}.devotel-cta-stack{display:flex;flex-direction:column;align-items:flex-start;gap:32px}.devotel-cta-content-wrapper{z-index:10}.devotel-cta-content-wrapper h2{font-size:clamp(36px,5vw,48px);font-weight:600;color:#fff;line-height:60px;letter-spacing:-.02em;text-align:left}.devotel-cta-content-wrapper p{font-size:18px;color:rgba(255,255,255,.9);line-height:28px;text-align:left}</style>
</head>
<body>
	<!-- CTA Section -->
	<section class="devotel-cta-section">
		<div class="devotel-cta-section-container">
			<!-- Video Background - Fully covers container, positioned to the right -->
			<div class="devotel-cta-video-wrapper">
				<div class="devotel-cta-video-gradient-container">
					<video preload="none" 
						autoplay 
						loop 
						muted 
						playsinline
					>
						<source src="https://devotel.com/wp-content/uploads/2025/11/logo-alpha.webm" type="video/webm">
						Your browser does not support the video tag.
					</video>
				</div>
			</div>

			<!-- Video Background (Mobile only) -->
			<div class="devotel-cta-video-wrapper-mobile">
				<div class="devotel-cta-video-gradient-container">
					<video preload="none" 						autoplay
						loop
						muted
						playsinline
					>
						<source src="https://devotel.com/wp-content/uploads/2026/01/logo-alpha-mobile.webm" type="video/webm">
						Your browser does not support the video tag.
					</video>
				</div>
			</div>
			
			<!-- Content Container - Left aligned, positioned like image -->
			<div class="devotel-cta-content-wrapper">
			<div class="devotel-cta-stack">
				<!-- Heading -->
				<h2 class="devotel-cta-font-duplet">
					Enhance and Scale Your Communication Today with Devotel's solutions
				</h2>
				
				<!-- Description -->
				<p class="devotel-cta-desc">
					Join 500+ companies who chose us for reliable, customisable, and carrier-grade solutions worldwide.
				</p>
				
				<!-- Buttons Container -->
				<div class="devotel-cta-button">
					<!-- Primary Button -->
					<button class="devotel-cta-button2" id="devotel-cta-scroll-to-cm7-button">
						<div class="devotel-cta-content">
							<span class="devotel-cta-talk-to-an">Start now</span>
							<svg 
								class="devotel-cta-icon" 
								xmlns="http://www.w3.org/2000/svg" 
								viewBox="0 0 20 20" 
								fill="none"
							>
								<path 
									d="M4.16406 10H15.8307" 
									stroke="currentColor" 
									stroke-width="1.66566" 
									stroke-linecap="round" 
									stroke-linejoin="round"
								/>
								<path 
									d="M10 4.16699L15.8333 10.0003L10 15.8337" 
									stroke="currentColor" 
									stroke-width="1.66566" 
									stroke-linecap="round" 
									stroke-linejoin="round"
								/>
              </svg>
            </div>
					</button>
            </div>
            </div>
        </div>
    </div>
</div>
	</section>
	
	<script defer>document.addEventListener('DOMContentLoaded', function() {
const button = document.getElementById('devotel-cta-scroll-to-cm7-button');
if (button) {
button.addEventListener('click', function(e) {
e.preventDefault();
let targetElement = document.getElementById('cm7');
if (!targetElement) {
targetElement = document.querySelector('.cm7');
}
if (targetElement) {
targetElement.scrollIntoView({
behavior: 'smooth',
block: 'start'
});
} else {
console.warn('Element with id or class "cm7" not found');
}
});
}
});</script>
</body>
</html>
    				</div>
				</div>
				</div>
				<footer data-elementor-type="footer" data-elementor-id="73" class="elementor elementor-73 elementor-location-footer" data-elementor-post-type="elementor_library">
			<div class="elementor-element elementor-element-a8b1782 e-con-full e-flex e-con e-parent" data-id="a8b1782" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-3f0d30e elementor-widget elementor-widget-html" data-id="3f0d30e" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="initial-scale=1, width=device-width">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	<script src="https://cdn.tailwindcss.com"></script>
	<script>
		// Configure Tailwind to scope to footer only and prevent global conflicts
		if (typeof tailwind !== 'undefined') {
			tailwind.config = {
				important: '#devotel-footer-wrapper',
				// Prevent Tailwind from affecting elements outside footer
				corePlugins: {
					preflight: false // Disable global reset to prevent conflicts with Elementor
				}
			}
		}
		
		// Additional protection: Prevent Tailwind from applying to blog content
		document.addEventListener('DOMContentLoaded', function() {
			const blogContent = document.getElementById('asd');
			if (blogContent) {
				// Ensure blog content is not affected by Tailwind
				blogContent.setAttribute('data-no-tailwind', 'true');
			}
		});
	</script>
<style>
		/* ============================================
		   CRITICAL: Complete isolation for blog content
		   Prevents ALL footer/Tailwind styles from affecting Elementor blog content
		   ============================================ */
		
		/* Create isolation layer for blog content - prevents style leakage */
		#asd,
		.elementor-element-ffb1353,
		.elementor-widget-theme-post-content,
		[data-id="ffb1353"][id="asd"] {
			/* Isolation and containment to prevent style leakage */
			isolation: isolate !important;
			contain: layout style paint !important;
			position: relative !important;
			z-index: auto !important;
			box-sizing: border-box !important;
			
			/* Reset any potential Tailwind/footer interference */
			margin: 0 !important;
			padding: 0 !important;
			border: none !important;
			background: transparent !important;
			width: auto !important;
			height: auto !important;
			min-width: 0 !important;
			min-height: 0 !important;
			max-width: none !important;
			max-height: none !important;
			display: block !important;
		}
		
		/* Ensure children maintain Elementor's default styling */
		#asd *,
		.elementor-element-ffb1353 *,
		.elementor-widget-theme-post-content * {
              box-sizing: border-box;
          }
          
		/* Protect paragraph and text element styling */
		#asd p,
		#asd .wp-block-paragraph,
		.elementor-element-ffb1353 p,
		.elementor-widget-theme-post-content p {
			margin: revert !important;
			margin-top: 1em !important;
			margin-bottom: 1em !important;
			padding: 0 !important;
			line-height: 1.6 !important;
			/* Removed font-size and color to allow Elementor to control them */
			font-family: revert !important;
			font-weight: revert !important;
			text-align: revert !important;
		}
		
		/* Protect heading styles - ONLY spacing, NO font/color overrides */
		#asd h1,
		#asd h2,
		#asd h3,
		#asd h4,
		#asd h5,
		#asd h6,
		#asd .wp-block-heading,
		.elementor-element-ffb1353 h1,
		.elementor-element-ffb1353 h2,
		.elementor-element-ffb1353 h3,
		.elementor-element-ffb1353 h4,
		.elementor-element-ffb1353 h5,
		.elementor-element-ffb1353 h6 {
			margin: revert !important;
			margin-top: 1.5em !important;
			margin-bottom: 0.5em !important;
			padding: 0 !important;
			line-height: 1.2 !important;
			/* NO font-family, font-size, font-weight, or color - let Elementor control all fonts and colors */
		}
		
		/* Protect list styles */
		#asd ul,
		#asd ol,
		#asd .wp-block-list,
		.elementor-element-ffb1353 ul,
		.elementor-element-ffb1353 ol {
			margin: revert !important;
			margin-top: 1em !important;
			margin-bottom: 1em !important;
			padding-left: revert !important;
			list-style: revert !important;
		}
		
		#asd li,
		.elementor-element-ffb1353 li {
			margin: revert !important;
			padding: revert !important;
			line-height: revert !important;
		}
		
		/* Protect link styles */
		#asd a,
		.elementor-element-ffb1353 a {
			/* Removed color to allow Elementor to control it */
			text-decoration: revert !important;
			font-weight: revert !important;
		}
		
		/* Protect image styles */
		#asd img,
		#asd figure,
		.elementor-element-ffb1353 img,
		.elementor-element-ffb1353 figure {
			margin: revert !important;
			padding: revert !important;
			max-width: 100% !important;
			height: auto !important;
		}
		
		/* Protect blockquote styles */
		#asd blockquote,
		.elementor-element-ffb1353 blockquote {
			margin: revert !important;
			padding: revert !important;
			border: revert !important;
			font-style: revert !important;
		}
		
		/* Protect all text content from footer interference */
		#asd *:not(script):not(style),
		.elementor-element-ffb1353 *:not(script):not(style) {
			/* NO font-family, font-size, or color overrides - let Elementor control all fonts and colors */
		}
		
		/* Ensure proper spacing between elements in blog content */
		#asd > *:first-child,
		.elementor-element-ffb1353 > *:first-child {
			margin-top: 0 !important;
		}
		
		#asd > *:last-child,
		.elementor-element-ffb1353 > *:last-child {
			margin-bottom: 0 !important;
		}
		
		/* Protect spacing between sibling elements */
		#asd p + p,
		.elementor-element-ffb1353 p + p {
			margin-top: 1em !important;
		}
		
		#asd h2 + p,
		#asd h3 + p,
		.elementor-element-ffb1353 h2 + p,
		.elementor-element-ffb1353 h3 + p {
			margin-top: 1em !important;
		}
		
		/* Ensure proper line height for readability */
		#asd,
		.elementor-element-ffb1353 {
			line-height: 1.6 !important;
		}
		
		/* Prevent footer wrapper from affecting blog content */
		#devotel-footer-wrapper {
			contain: layout style paint;
		}
		
		/* Additional protection: If blog content is a sibling of footer */
		#devotel-footer-wrapper ~ #asd,
		#devotel-footer-wrapper ~ .elementor-element-ffb1353 {
			isolation: isolate !important;
		}
		
		/* Prevent any Tailwind utility classes from affecting blog content */
		#asd[class*="bg-"],
		#asd[class*="text-"],
		#asd[class*="p-"],
		#asd[class*="m-"],
		#asd[class*="flex"],
		#asd[class*="grid"] {
			/* These should be handled by Elementor, not Tailwind */
		}
		
		/* Override any Tailwind spacing utilities on blog content */
		#asd[class*="p-"] p,
		#asd[class*="m-"] p,
		.elementor-element-ffb1353[class*="p-"] p,
		.elementor-element-ffb1353[class*="m-"] p {
			margin: 1em 0 !important;
			padding: 0 !important;
		}
		
		/* Ensure WordPress block editor styles are preserved */
		#asd .wp-block-paragraph,
		.elementor-element-ffb1353 .wp-block-paragraph {
			margin: 1em 0 !important;
			padding: 0 !important;
		}
		
		#asd .wp-block-heading,
		.elementor-element-ffb1353 .wp-block-heading {
			margin: 1.5em 0 0.5em 0 !important;
			padding: 0 !important;
		}
		
		#asd .wp-block-list,
		.elementor-element-ffb1353 .wp-block-list {
			margin: 1em 0 !important;
			padding-left: 2em !important;
		}
		
		#asd .wp-block-image,
		.elementor-element-ffb1353 .wp-block-image {
			margin: 1em 0 !important;
		}
		
		/* Scoped to footer container only - prevents Elementor conflicts */
		#devotel-footer-wrapper,
		#devotel-footer-wrapper * {
			box-sizing: border-box;
		}
		
		/* Ensure footer styles NEVER affect blog content */
		#devotel-footer-wrapper #asd,
		#devotel-footer-wrapper .elementor-element-ffb1353,
		#devotel-footer-wrapper .elementor-widget-theme-post-content {
			/* If blog content somehow ends up in footer, reset it */
			all: revert !important;
		}
		#devotel-footer-wrapper .devotel-cert-badge {
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
			transform: translateZ(0);
			-webkit-transform: translateZ(0);
		}
		#devotel-footer-wrapper .devotel-cert-badge img {
			image-rendering: auto;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			transform: translateZ(0);
			-webkit-transform: translateZ(0);
		}
		#devotel-footer-wrapper .devotel-cert-badge {
			overflow: visible;
		}
		#devotel-footer-wrapper .devotel-cert-badge-container {
			position: relative;
			overflow: visible;
			height: 65px;
			border-radius: 10px;
		}
		#devotel-footer-wrapper .devotel-cert-badge-icon {
			height: 65px;
			background-color: #172154;
    display: flex;
    align-items: center;
    justify-content: center;
			border-radius: 10px;
    position: relative;
			z-index: 2;
		}
		#devotel-footer-wrapper .devotel-cert-badge-label {
			position: absolute;
			top: 51px;
			left: 0;
			width: 65px;
			height: 32px;
			background-color: rgba(60, 117, 246, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
			padding: 0 4px;
			border-radius: 0 0 10px 10px;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			z-index: 1;
		}
		#devotel-footer-wrapper .devotel-cert-badge-label-text {
			color: #ffffff;
        text-align: center;
			line-height: normal;
			font-family: 'Inter', sans-serif;
    display: flex;
        flex-direction: column;
        align-items: center;
    justify-content: center;
			gap: 2px;
