<span class="wpcf7-form-control-wrap" data-name="firstname"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required form-input" aria-required="true" aria-invalid="false" placeholder="First name" value="" type="text" name="firstname" /></span>
					</p>
				</div>
				<div class="form-field">
					<p><label class="form-label">Last name <span class="form-asterisk">*</span></label><br />
<span class="wpcf7-form-control-wrap" data-name="lastname"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required form-input" aria-required="true" aria-invalid="false" placeholder="Last name" value="" type="text" name="lastname" /></span>
					</p>
				</div>
			</div>
			<div class="form-row">
				<div class="form-field">
					<p><label class="form-label">Email <span class="form-asterisk">*</span></label><br />
<span class="wpcf7-form-control-wrap" data-name="email"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email form-input" aria-required="true" aria-invalid="false" placeholder="you@company.com" value="" type="email" name="email" /></span>
					</p>
				</div>
			</div>
			<div class="form-row">
				<div class="form-field">
					<p><label class="form-label">Company Name</label><br />
<span class="wpcf7-form-control-wrap" data-name="company_name"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text form-input" aria-invalid="false" placeholder="Company name" value="" type="text" name="company_name" /></span>
					</p>
				</div>
			</div>
			<div class="form-row">
				<div class="form-field">
					<p><label class="form-label">Topic You Want to Talk About <span class="form-asterisk">*</span></label><br />
<span class="wpcf7-form-control-wrap" data-name="topic"><select class="wpcf7-form-control wpcf7-select wpcf7-validates-as-required form-input" aria-required="true" aria-invalid="false" name="topic"><option value="Partnership">Partnership</option><option value="Voice Services for Telco">Voice Services for Telco</option><option value="SMS Services for Telco">SMS Services for Telco</option><option value="Connectivity Management Platform (CMP)">Connectivity Management Platform (CMP)</option><option value="Customer Communication Platform (Orbit)">Customer Communication Platform (Orbit)</option><option value="Communication APIs">Communication APIs</option><option value="Esimora">Esimora</option><option value="DevHub">DevHub</option><option value="SIM-Based Solutions">SIM-Based Solutions</option><option value="Other">Other</option></select></span>
					</p>
				</div>
			</div>
			<div class="form-row">
				<div class="form-field">
					<p><label class="form-label">Phone number <span class="form-asterisk"></span></label><br />
<span class="wpcf7-form-control-wrap" data-name="phonetext-255"><input size="40" class="wpcf7-form-control wpcf7-phonetext wpcf7-text wpcf7-validates-as-phonetext form-input" aria-invalid="false" placeholder="Phone number" value="" type="text" name="phonetext-255" /><input type="hidden" name="phonetext-255-country-code" class="wpcf7-phonetext-country-code" /></span>
					</p>
				</div>
