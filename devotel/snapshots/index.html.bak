            <path fill-rule="evenodd" clip-rule="evenodd" d="M49.5639 18.0234H22.5291C20.0728 18.0196 18.0276 20.0774 18.0233 22.5293V49.5641C18.0233 52.0523 20.0411 54.0699 22.5291 54.0699H49.5639C52.0202 54.0738 54.0654 52.0159 54.0697 49.5641V22.5293C54.0697 20.041 52.0529 18.0234 49.5639 18.0234ZM40.8517 24.632C40.8517 23.9691 41.3906 23.4304 42.0543 23.4304C42.7179 23.4304 43.2558 23.9691 43.2558 24.632V40.6857C43.2558 41.3485 42.7169 41.8872 42.0543 41.8872C41.4181 41.8878 40.8543 41.3239 40.8527 40.6857L40.8517 24.632ZM34.844 24.0242C34.844 23.3603 35.3829 22.8226 36.0465 22.8226C36.7101 22.8226 37.249 23.3603 37.249 24.0242V41.4467C37.249 42.1105 36.7101 42.6482 36.0465 42.6482C35.4104 42.6487 34.8465 42.0849 34.845 41.4467L34.844 24.0242ZM28.8372 24.632C28.8372 23.9691 29.3761 23.4304 30.0388 23.4304C30.7024 23.4304 31.2403 23.9691 31.2403 24.632V40.6857C31.2403 41.3485 30.7024 41.8872 30.0388 41.8872C29.4026 41.8878 28.8388 41.3239 28.8372 40.6857V24.632ZM22.8295 27.0351C22.8295 26.3712 23.3674 25.8335 24.031 25.8335C24.6947 25.8335 25.2326 26.3712 25.2326 27.0351V37.842C25.2326 38.5059 24.6937 39.0436 24.031 39.0436C23.3759 39.0446 22.8305 38.4959 22.8295 37.842V27.0351ZM48.8444 45.3627C48.6598 45.5229 44.2079 49.2567 36.0465 49.2567C27.8851 49.2567 23.4362 45.5219 23.2486 45.3617C22.7522 44.9364 22.6934 44.1646 23.1189 43.6685C23.5336 43.1857 24.3251 43.1238 24.8094 43.5363C24.8793 43.5954 28.8542 46.8536 36.0455 46.8536C43.3267 46.8536 47.2407 43.5714 47.2786 43.5393C47.7622 43.1238 48.5567 43.1843 48.9721 43.6685C49.4004 44.1636 49.3424 44.9375 48.8444 45.3627ZM49.2635 37.843C49.2635 38.5059 48.7246 39.0446 48.062 39.0446C47.4069 39.0456 46.8615 38.4969 46.8604 37.843V27.0351C46.8604 26.3712 47.3984 25.8335 48.061 25.8335C48.7246 25.8335 49.2635 26.3712 49.2635 27.0351V37.843Z" fill="white" />
