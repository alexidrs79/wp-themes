    </div>

    <script>
        // Custom dropdown for phone country code — supports multiple `.final-cta-form-wrapper` on one page
        (function() {
            'use strict';

            function fcta7cfCloseAllCountryDropdowns() {
                document.querySelectorAll('.final-cta-form-wrapper .custom-country-dropdown').forEach(function (dropdown) {
                    dropdown.classList.remove('open');
                    var prev = dropdown.previousElementSibling;
                    if (prev) prev.setAttribute('aria-expanded', 'false');
                });
            }

            function fcta7cfResolveFormFromWpcf7Event(event) {
                var t = event.target;
                if (t && t.nodeType === 1 && t.classList && t.classList.contains('wpcf7-form')) {
                    return t;
                }
                if (t && t.nodeType === 1) {
                    var w = t.classList && t.classList.contains('wpcf7') ? t : (t.closest ? t.closest('.wpcf7') : null);
                    if (w) {
                        var f = w.querySelector('form.wpcf7-form');
                        if (f) return f;
                    }
                    if (t.closest) {
                        var f2 = t.closest('form.wpcf7-form');
                        if (f2) return f2;
                    }
                }
                var tag = event.detail && event.detail.unitTag;
                if (tag) {
                    var root = document.getElementById(tag);
                    if (root && root.querySelector) {
                        var f3 = root.querySelector('form.wpcf7-form');
                        if (f3) return f3;
                    }
                }
                return null;
            }

            function fcta7cfFindResponseOutput(form) {
                if (!form) return null;
                var o = form.querySelector('.wpcf7-response-output');
                if (o) return o;
                var wrap = form.closest ? form.closest('.wpcf7') : null;
                return wrap && wrap.querySelector ? wrap.querySelector('.wpcf7-response-output') : null;
            }

            function showCf7CustomSuccess(form) {
                if (!form || !form.classList || !form.classList.contains('wpcf7-form')) return;
                var fields = form.querySelector('.fcta7cf-fields');
                var success = form.querySelector('.fcta7cf-sent');
                if (!fields || !success) return;

                var wpcf7root = form.closest('.wpcf7');
                if (wpcf7root) wpcf7root.classList.add('fcta7cf-wp7-sentouter');

                form.classList.add('fcta7cf-wp7-sentview');
                fields.hidden = true;
                fields.setAttribute('aria-hidden', 'true');
                success.hidden = false;
                success.removeAttribute('hidden');
                success.setAttribute('aria-hidden', 'false');

                var out = fcta7cfFindResponseOutput(form);
                if (out) {
                    out.setAttribute('hidden', '');
                    out.setAttribute('aria-hidden', 'true');
                    out.style.display = 'none';
                }
            }

            function hideCf7CustomSuccess(form) {
                if (!form) return;
                var fields = form.querySelector('.fcta7cf-fields');
                var success = form.querySelector('.fcta7cf-sent');
                if (!fields || !success) return;

                var wpcf7root = form.closest('.wpcf7');
                if (wpcf7root) wpcf7root.classList.remove('fcta7cf-wp7-sentouter');

                form.classList.remove('fcta7cf-wp7-sentview');
                success.hidden = true;
                success.setAttribute('aria-hidden', 'true');
                fields.hidden = false;
                fields.removeAttribute('hidden');
                fields.setAttribute('aria-hidden', 'false');

                var out = fcta7cfFindResponseOutput(form);
                if (out) {
                    out.removeAttribute('hidden');
                    out.removeAttribute('aria-hidden');
                    out.style.display = '';
                }
            }

            var fcta7cfDocumentListenersBound = false;
            function fcta7cfBindDocumentListenersOnce() {
                if (fcta7cfDocumentListenersBound) return;
                fcta7cfDocumentListenersBound = true;
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.final-cta-form-wrapper .custom-country-select')) {
                        fcta7cfCloseAllCountryDropdowns();
                    }
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') fcta7cfCloseAllCountryDropdowns();
                });
                document.addEventListener('wpcf7mailsent', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest || !form.closest('.final-cta-form-wrapper')) return;
                    showCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7invalid', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7spam', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
                document.addEventListener('wpcf7mailfailed', function (event) {
                    var form = fcta7cfResolveFormFromWpcf7Event(event);
                    if (!form || !form.closest('.final-cta-form-wrapper')) return;
                    hideCf7CustomSuccess(form);
                }, false);
            }

            function bootFinalCtaFormWrappers() {
                var wrappers = document.querySelectorAll('.final-cta-form-wrapper');
                if (!wrappers.length) return;
                fcta7cfBindDocumentListenersOnce();

                wrappers.forEach(function (formWrapper) {
                    if (formWrapper.dataset.fcta7cfInitialized === '1') return;
                    formWrapper.dataset.fcta7cfInitialized = '1';

            // Country code to flag mapping
            function getCountryFlagClass(countryCode) {
                const flagMap = {
                    'GB': 'fi-gb', 'US': 'fi-us', 'UAE': 'fi-ae', 'FR': 'fi-fr', 'DE': 'fi-de',
                    'IT': 'fi-it', 'ES': 'fi-es', 'NL': 'fi-nl', 'BE': 'fi-be', 'CH': 'fi-ch',
                    'AT': 'fi-at', 'SE': 'fi-se', 'NO': 'fi-no', 'DK': 'fi-dk', 'FI': 'fi-fi',
                    'PL': 'fi-pl', 'CZ': 'fi-cz', 'IE': 'fi-ie', 'PT': 'fi-pt', 'GR': 'fi-gr',
                    'AU': 'fi-au', 'CA': 'fi-ca', 'NZ': 'fi-nz', 'JP': 'fi-jp', 'KR': 'fi-kr',
                    'CN': 'fi-cn', 'IN': 'fi-in', 'SG': 'fi-sg', 'MY': 'fi-my', 'TH': 'fi-th',
                    'PH': 'fi-ph', 'ID': 'fi-id', 'VN': 'fi-vn', 'BR': 'fi-br', 'MX': 'fi-mx',
                    'AR': 'fi-ar', 'CL': 'fi-cl', 'CO': 'fi-co', 'ZA': 'fi-za', 'EG': 'fi-eg',
                    'SA': 'fi-sa', 'IL': 'fi-il', 'TR': 'fi-tr', 'RU': 'fi-ru'
                };
                return flagMap[countryCode] || 'fi-xx';
            }
            
            function createFlagElement(countryCode) {
                const flagSpan = document.createElement('span');
                flagSpan.className = `fi ${getCountryFlagClass(countryCode)} country-flag`;
                return flagSpan;
            }
            
            function initCustomCountryDropdown() {
                const selects = formWrapper.querySelectorAll('.phone-country-code-wrapper select.phone-country-code, .wpcf7-select.phone-country-code');
            
            selects.forEach(select => {
                const wrapper = select.closest('.phone-country-code-wrapper');
                if (!wrapper) return;
                
                // Skip if already converted
                if (wrapper.querySelector('.custom-country-select')) {
                    return;
                }
                
                // Create custom dropdown structure
                const customSelect = document.createElement('div');
                customSelect.className = 'custom-country-select';
                
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'custom-country-select-button';
                button.setAttribute('aria-haspopup', 'listbox');
                button.setAttribute('aria-expanded', 'false');
                
                const dropdown = document.createElement('div');
                dropdown.className = 'custom-country-dropdown';
                dropdown.setAttribute('role', 'listbox');
                
                // Get current value
                const currentValue = select.value || select.options[0]?.value || '';
                const currentText = select.options[select.selectedIndex]?.text || select.options[0]?.text || '';
                
                // Set button content with flag
                const buttonFlag = createFlagElement(currentValue);
                const buttonText = document.createTextNode(currentValue);
                button.appendChild(buttonFlag);
                button.appendChild(buttonText);
                
                // Create options
                Array.from(select.options).forEach(option => {
                    const optionDiv = document.createElement('div');
                    optionDiv.className = 'custom-country-option';
                    if (option.value === currentValue) {
                        optionDiv.classList.add('selected');
                    }
                    
                    // Add flag
                    const optionFlag = createFlagElement(option.value);
                    optionDiv.appendChild(optionFlag);
                    
                    // Add country code text
                    const optionText = document.createTextNode(option.value);
                    optionDiv.appendChild(optionText);
                    
                    optionDiv.setAttribute('data-value', option.value);
                    optionDiv.setAttribute('role', 'option');
                    optionDiv.setAttribute('aria-selected', option.value === currentValue);
                    
                    optionDiv.addEventListener('click', () => {
                        select.value = option.value;
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                        
                        // Update button with new flag and text
                        button.innerHTML = '';
                        const newButtonFlag = createFlagElement(option.value);
                        const newButtonText = document.createTextNode(option.value);
                        button.appendChild(newButtonFlag);
                        button.appendChild(newButtonText);
                        
                        // Get existing arrow
                        const existingArrow = wrapper.querySelector('.phone-country-arrow');
                        if (existingArrow) {
                            const arrowClone = existingArrow.cloneNode(true);
                            button.appendChild(arrowClone);
                        }
                        
                        dropdown.querySelectorAll('.custom-country-option').forEach(opt => {
                            opt.classList.remove('selected');
                            opt.setAttribute('aria-selected', 'false');
                        });
                        optionDiv.classList.add('selected');
                        optionDiv.setAttribute('aria-selected', 'true');
                        dropdown.classList.remove('open');
                        button.setAttribute('aria-expanded', 'false');
                    });
                    
                    dropdown.appendChild(optionDiv);
                });
                
                // Toggle dropdown
                button.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = dropdown.classList.contains('open');
                    fcta7cfCloseAllCountryDropdowns();
                    if (!isOpen) {
                        dropdown.classList.add('open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
                
                // Get existing arrow
                const existingArrow = wrapper.querySelector('.phone-country-arrow');
                if (existingArrow) {
                    const arrowClone = existingArrow.cloneNode(true);
                    button.appendChild(arrowClone);
                } else {
                    // Create arrow if it doesn't exist
                    const arrow = document.createElement('svg');
                    arrow.className = 'phone-country-arrow';
                    arrow.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
                    arrow.setAttribute('width', '16');
                    arrow.setAttribute('height', '16');
                    arrow.setAttribute('viewBox', '0 0 16 16');
                    arrow.setAttribute('fill', 'none');
                    arrow.innerHTML = '<path d="M4 6L8 10L12 6" stroke="#A4A7AE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>';
                    button.appendChild(arrow);
                }
                
                customSelect.appendChild(button);
                customSelect.appendChild(dropdown);
                
                // Insert custom select before the native select
                wrapper.insertBefore(customSelect, select);
                
                // Hide native select but keep it for form submission
                select.classList.add('hidden-select');
            });
        }

            initCustomCountryDropdown();

            // Re-initialize when Contact Form 7 loads the form dynamically
            const countryDropdownObserver = new MutationObserver(() => {
                initCustomCountryDropdown();
            });

            countryDropdownObserver.observe(formWrapper, {
                childList: true,
                subtree: true
            });

            // Also try after a delay for CF7
            setTimeout(initCustomCountryDropdown, 500);
            setTimeout(initCustomCountryDropdown, 1000);
            setTimeout(initCustomCountryDropdown, 2000);
            
            // Fix privacy checkbox layout
            function fixPrivacyCheckbox() {
                const checkboxRows = formWrapper.querySelectorAll('p:has(input[type="checkbox"]), p:has([acceptance]), .form-checkbox-wrapper');
                checkboxRows.forEach(row => {
                    if (row) {
                        // Use inline-block method instead of flex
                        row.style.display = 'block';
                        row.style.fontSize = '0';
                        row.style.whiteSpace = 'nowrap';
                        row.style.paddingLeft = '0';
                        row.style.marginLeft = '0';
                        row.style.paddingRight = '0';
                        row.style.marginRight = '0';
                        row.style.textAlign = 'left';
                        row.style.width = '100%';
                        row.style.maxWidth = '100%';
                        row.style.boxSizing = 'border-box';
                        
                        // Make all children inline-block with no spacing
                        Array.from(row.children).forEach((child) => {
                            child.style.display = 'inline-block';
                            child.style.verticalAlign = 'middle';
                            child.style.margin = '0';
                            child.style.marginLeft = '0';
                            child.style.marginRight = '0';
                            child.style.padding = '0';
                            child.style.paddingLeft = '0';
                            child.style.paddingRight = '0';
                            child.style.fontSize = '16px';
                            
                            // If it's the checkbox input, add small right margin and styles
                            if (child.tagName === 'INPUT' && child.type === 'checkbox') {
                                child.style.marginRight = '8px';
                                child.style.marginLeft = '0';
                                child.style.marginTop = '0';
                                child.style.marginBottom = '0';
                                child.style.borderRadius = 'var(--spacing-sm, 6px)';
                                child.style.border = '1px solid var(--Border-border-primary, #CAD5E2)';
                            }
                            // If it's a span or wrapper containing checkbox
                            if (child.querySelector && child.querySelector('input[type="checkbox"]')) {
                                const checkbox = child.querySelector('input[type="checkbox"]');
                                if (checkbox) {
                                    checkbox.style.marginRight = '8px';
                                    checkbox.style.marginLeft = '0';
                                    checkbox.style.marginTop = '0';
                                    checkbox.style.marginBottom = '0';
                                    checkbox.style.borderRadius = 'var(--spacing-sm, 6px)';
                                    checkbox.style.border = '1px solid var(--Border-border-primary, #CAD5E2)';
                                }
                            }
                            // Labels
                            if (child.tagName === 'LABEL' || child.querySelector('label')) {
                                const label = child.tagName === 'LABEL' ? child : child.querySelector('label');
                                if (label) {
                                    label.style.display = 'inline-block';
                                    label.style.margin = '0';
                                    label.style.padding = '0';
                                    label.style.verticalAlign = 'middle';
                                }
                            }
                        });
                        
                        // Make all children inline
                        Array.from(row.children).forEach(child => {
                            if (child.tagName === 'LABEL' || child.tagName === 'SPAN') {
                                child.style.display = 'inline';
                                child.style.whiteSpace = 'nowrap';
                            }
                            // Remove any br tags
                            child.querySelectorAll('br').forEach(br => br.remove());
                        });
                    }
                });
            }
            
            // Replace iti-arrow with custom SVG
            function replaceItiArrow() {
                const itiArrows = formWrapper.querySelectorAll('.iti-arrow');
                itiArrows.forEach(arrow => {
                    // Skip if already replaced
                    if (arrow.querySelector('svg.custom-arrow-svg')) {
                        return;
                    }
                    
                    // Create SVG element
                    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
                    svg.setAttribute('width', '16');
                    svg.setAttribute('height', '16');
                    svg.setAttribute('viewBox', '0 0 16 16');
                    svg.setAttribute('fill', 'none');
                    svg.className = 'custom-arrow-svg';
                    
                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    path.setAttribute('d', 'M4 6L8 10L12 6');
                    path.setAttribute('stroke', '#A4A7AE');
                    path.setAttribute('stroke-width', '1.75');
                    path.setAttribute('stroke-linecap', 'round');
                    path.setAttribute('stroke-linejoin', 'round');
                    
                    svg.appendChild(path);
                    
                    // Replace arrow content
                    arrow.innerHTML = '';
                    arrow.appendChild(svg);
                    arrow.style.display = 'inline-block';
                    arrow.style.width = '16px';
                    arrow.style.height = '16px';
                });
            }
            
            // Run on load and after CF7 loads
            setTimeout(fixPrivacyCheckbox, 100);
            setTimeout(fixPrivacyCheckbox, 500);
            setTimeout(fixPrivacyCheckbox, 1000);
            setTimeout(fixPrivacyCheckbox, 2000);
            
            // Replace iti-arrow on load
            setTimeout(replaceItiArrow, 100);
            setTimeout(replaceItiArrow, 500);
            setTimeout(replaceItiArrow, 1000);
            setTimeout(replaceItiArrow, 2000);
            
            // Set default value for Topic dropdown
            function setTopicDefault() {
                const topicSelect = formWrapper.querySelector('select[name="topic"]');
                if (topicSelect) {
                    // Don't override if user has manually changed the value
                    if (topicSelect.hasAttribute('data-user-changed')) {
                        return;
                    }
                    
                    // Wait for options to be populated (CF7 might load them dynamically)
                    const options = Array.from(topicSelect.querySelectorAll('option'));
                    if (options.length === 0) {
                        // Options not loaded yet, try again later
                        return;
                    }
                    
                    // Find the option with text "Connectivity Management Platform (CMP)"
                    let foundDefault = false;
                    let defaultOption = null;
                    
                    options.forEach(option => {
                        const optionText = option.textContent.trim();
                        const optionValue = option.value.trim();
                        
                        // Check if this is the "Connectivity Management Platform (CMP)" option (match text or value)
                        if (optionText === 'Connectivity Management Platform (CMP)' || optionValue === 'Connectivity Management Platform (CMP)' || 
                            optionText.includes('Connectivity Management Platform (CMP)') || optionValue.includes('Connectivity Management Platform (CMP)')) {
                            defaultOption = option;
                            foundDefault = true;
                        }
                    });
                    
                    if (foundDefault && defaultOption) {
                        // Get the actual value to use
                        const optionValue = defaultOption.value.trim() || defaultOption.textContent.trim();
                        
                        // Only set if current value is not already "Connectivity Management Platform (CMP)"
                        const currentValue = topicSelect.value.trim();
                        const currentText = topicSelect.options[topicSelect.selectedIndex]?.textContent.trim();
                        
                        if (currentValue !== optionValue && currentText !== 'Connectivity Management Platform (CMP)') {
                            // Set the value directly
                            topicSelect.value = optionValue;
                            
                            // Also set selected attribute on all options
                            options.forEach(opt => opt.selected = false);
                            defaultOption.selected = true;
                            
                            // Mark as default set
                            topicSelect.setAttribute('data-default-set', 'true');
                            // Add has-value class for color styling
                            topicSelect.classList.add('has-value');
                            
                            // Use a small delay before triggering change to ensure value is set
                            setTimeout(() => {
                                topicSelect.dispatchEvent(new Event('change', { bubbles: true }));
                            }, 10);
                        } else if (currentText === 'Connectivity Management Platform (CMP)' || currentValue === optionValue) {
                            // Already set, just ensure classes are correct
                            topicSelect.setAttribute('data-default-set', 'true');
                            topicSelect.classList.add('has-value');
                        }
                    } else {
                        // If default was already set, just ensure has-value class is set
                        if (topicSelect.value && topicSelect.value !== '') {
                            topicSelect.classList.add('has-value');
                        }
                    }
                }
            }
            
            // Update select color when value changes
            function updateSelectColor() {
                const topicSelect = formWrapper.querySelector('select[name="topic"]');
                if (topicSelect && !topicSelect.hasAttribute('data-color-listener')) {
                    // Mark as having listener to avoid duplicates
                    topicSelect.setAttribute('data-color-listener', 'true');
                    
                    // Add change event listener
                    topicSelect.addEventListener('change', function() {
                        // Mark that user has manually changed the value
                        this.setAttribute('data-user-changed', 'true');
                        
                        if (this.value && this.value !== '') {
                            this.classList.add('has-value');
                        } else {
                            this.classList.remove('has-value');
                        }
                    });
                    
                    // Set initial state
                    if (topicSelect.value && topicSelect.value !== '') {
                        topicSelect.classList.add('has-value');
                    }
                }
            }
            
            // Run on load and after CF7 loads
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 100);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 500);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 1000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 2000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 3000);
            setTimeout(() => {
                setTopicDefault();
                updateSelectColor();
            }, 5000);
            
            // Also watch for form changes
            const formObserver = new MutationObserver(() => {
                fixPrivacyCheckbox();
                replaceItiArrow();
                setTopicDefault();
                updateSelectColor();
            });
            formObserver.observe(formWrapper, {
                childList: true,
                subtree: true
            });

            function bindCf7SuccessUi(root) {
                if (!root) return;
                var scope = root;
                scope.querySelectorAll('form.wpcf7-form').forEach(function (cf7Form) {
                    if (cf7Form.dataset.fcta7cfSuccessBound === '1') return;
                    var successEl = cf7Form.querySelector('.fcta7cf-sent');
                    var btn = cf7Form.querySelector('.fcta7cf-sent-backbtn');
                    if (!successEl || !btn) return;
                    cf7Form.dataset.fcta7cfSuccessBound = '1';
                    btn.addEventListener('click', function () {
                        hideCf7CustomSuccess(cf7Form);
                        if (typeof wpcf7 !== 'undefined' && typeof wpcf7.reset === 'function') {
                            wpcf7.reset(cf7Form);
                        } else {
                            cf7Form.reset();
                        }
                        setTimeout(function () {
                            initCustomCountryDropdown();
                            fixPrivacyCheckbox();
                            replaceItiArrow();
                        }, 50);
                    });
                });
            }

            bindCf7SuccessUi(formWrapper);
            const successUiObserver = new MutationObserver(function () {
                bindCf7SuccessUi(formWrapper);
            });
            successUiObserver.observe(formWrapper, { childList: true, subtree: true });
            setTimeout(function () { bindCf7SuccessUi(formWrapper); }, 500);
            setTimeout(function () { bindCf7SuccessUi(formWrapper); }, 1500);

                }); /* end forEach wrapper */
            } /* end bootFinalCtaFormWrappers */

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bootFinalCtaFormWrappers);
            } else {
                bootFinalCtaFormWrappers();
            }
            setTimeout(bootFinalCtaFormWrappers, 800);
            setTimeout(bootFinalCtaFormWrappers, 2500);
        })();
    </script>
</body>
</html>

				</div>
				</div>
					</div>
				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-a6b8909 cm7 elementor-hidden-desktop e-flex e-con-boxed e-con e-parent" data-id="a6b8909" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-eb5aa58 e-con-full e-flex e-con e-child" data-id="eb5aa58" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-cd0fb91 elementor-invisible elementor-widget elementor-widget-heading" data-id="cd0fb91" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeIn&quot;}" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Contact us</h2>				</div>
				<div class="elementor-element elementor-element-e6f75c0 elementor-invisible elementor-widget elementor-widget-heading" data-id="e6f75c0" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeIn&quot;}" data-widget_type="heading.default">
