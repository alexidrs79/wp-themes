        /* Desktop: consistent 24px between form rows (flex gap only; CF7 <p> margins break rhythm) */
        @media (min-width: 769px) {
            .final-cta-form,
            .final-cta-form-wrapper .wpcf7-form {
                gap: 24px !important;
            }

            .final-cta-form-wrapper .fcta7cf-fields {
                gap: 24px !important;
            }

            .final-cta-form-wrapper .wpcf7-form > p,
            .final-cta-form-wrapper .wpcf7-form > div {
                margin-top: 0 !important;
                margin-bottom: 0 !important;
            }

            .final-cta-form-wrapper .wpcf7-submit,
            .final-cta-form-wrapper .form-submit-button,
            .final-cta-form-wrapper .wpcf7-form input[type="submit"],
            .final-cta-form-wrapper .wpcf7-form button[type="submit"],
            .final-cta-form-wrapper input[type="submit"],
            .final-cta-form-wrapper button[type="submit"] {
                margin-top: 0 !important;
            }

            /* Submit wrapper is inside .fcta7cf-fields; keep spacing from column gap only */
            .final-cta-form-wrapper .fcta7cf-fields > p:has(.wpcf7-submit),
            .final-cta-form-wrapper .fcta7cf-fields > p:has(input[type="submit"]),
            .final-cta-form-wrapper .fcta7cf-fields > p:has(button[type="submit"]) {
                margin-top: 0 !important;
                margin-bottom: 0 !important;
            }
        }

