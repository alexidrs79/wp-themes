            }

            /* Privacy / checkbox rows */
            .final-cta-form-wrapper .form-checkbox-wrapper,
            .final-cta-form-wrapper .wpcf7-form p:has(input[type="checkbox"]),
            .final-cta-form-wrapper .wpcf7-form > p:has([type="checkbox"]),
