    </div>
  </div>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TimelineMax.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TweenMax.min.js"></script>
  <script>
    // Random fade-in animation when section comes into view using GSAP TimelineMax
    function getRandomInt(min, max) {
        return Math.random() * (max - min) + min;
    }
  
    // Fisher-Yates shuffle algorithm
    function shuffleArray(array) {
        const shuffled = [...array];
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
    }
  
    function positionLogos() {
        // Scope to .integrations-section to prevent conflicts
        const integrationsSection = document.querySelector('.integrations-section');
        if (!integrationsSection) return;
        
        const logosContainer = integrationsSection.querySelector('.logos-container');
        if (!logosContainer) return;
        
        // Get all rectangle boxes (these are the empty containers) - scoped
        const rectangleBoxes = Array.from(integrationsSection.querySelectorAll('[class*="rectangle-"]')).filter(rect => 
            rect.classList.contains('logo-box')
        );
        
        // Get all logo elements (the actual icons)
        const logoElements = Array.from(integrationsSection.querySelectorAll('.slack, .teams, .zapier, .notion, .asana, .shopify, .trello, .whatsapp, .github, .atlassian, .mailchimp, .g-calendar, .dropbox, .g-drive, .jira, .figma, .discord, .intercom'));
        
        // Check if mobile view
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        
        if (isMobile) {
            // Mobile: Move each icon INTO its corresponding rectangle box
            logoElements.forEach((logo, index) => {
                if (index < rectangleBoxes.length) {
                    const rect = rectangleBoxes[index];
                    
                    // Remove logo from its current parent if it's not already in the rect
                    if (logo.parentNode !== rect) {
                        // Store original parent to restore later if needed
                        if (!logo.dataset.originalParent) {
                            logo.dataset.originalParent = logo.parentNode === logosContainer ? 'container' : 'other';
                        }
                        rect.appendChild(logo);
                    }
                    
                    // Style the icon to be centered in the box
                    logo.style.position = 'absolute';
                    logo.style.left = '50%';
                    logo.style.top = '50%';
                    logo.style.transform = 'translate(-50%, -50%)';
                    logo.style.width = '57px';
                    logo.style.height = '57px';
                    logo.style.margin = '0';
                    logo.style.padding = '0';
                    logo.style.zIndex = '2';
                }
            });
        } else {
            // Desktop: Restore icons to container and use original positioning logic with shuffle
            logoElements.forEach(logo => {
                // If icon was moved to a box, restore it to container
                if (logo.parentNode !== logosContainer && logo.parentNode.classList.contains('rectangle-')) {
                    if (logo.dataset.originalParent === 'container' || !logo.dataset.originalParent) {
                        logosContainer.appendChild(logo);
                    }
                }
                // Clear inline width/height so CSS sizes apply (slack, teams, atlassian use 76.899px on desktop)
                logo.style.width = '';
                logo.style.height = '';
            });
            
            const rectanglePositions = rectangleBoxes.map(rect => {
                const style = window.getComputedStyle(rect);
                return {
                    element: rect,
                    left: parseFloat(style.left) || 0,
                    top: parseFloat(style.top) || 0,
                    width: parseFloat(style.width) || 0,
                    height: parseFloat(style.height) || 0
                };
            });
            
            // Shuffle rectangle positions array
            const shuffledPositions = shuffleArray(rectanglePositions);
            
            // Assign each logo to a random rectangle position
            logoElements.forEach((logo, index) => {
                if (index < shuffledPositions.length) {
                    const rectPos = shuffledPositions[index];
                    const logoStyle = window.getComputedStyle(logo);
                    const logoWidth = parseFloat(logoStyle.width) || 76.9;
                    const logoHeight = parseFloat(logoStyle.height) || 76.9;
                    
                    const centerX = rectPos.left + (rectPos.width / 2) - (logoWidth / 2);
                    const centerY = rectPos.top + (rectPos.height / 2) - (logoHeight / 2);
                    
                    logo.style.position = 'absolute';
                    logo.style.left = centerX + 'px';
                    logo.style.top = centerY + 'px';
                    logo.style.zIndex = '10';
                    logo.style.transform = 'none';
                }
            });
        }
    }
  
    document.addEventListener('DOMContentLoaded', function() {
        // Scope to .integrations-section to prevent conflicts
        const integrationsSection = document.querySelector('.integrations-section');
        if (!integrationsSection) return;
        
        const logosContainer = integrationsSection.querySelector('.logos-container');
        if (!logosContainer) return;
        
        // Get all rectangle boxes (these are the empty containers) - scoped
        const rectangleBoxes = Array.from(integrationsSection.querySelectorAll('[class*="rectangle-"]')).filter(rect => 
            rect.classList.contains('logo-box')
        );
        
        // Get all logo elements (the actual icons)
        const logoElements = Array.from(integrationsSection.querySelectorAll('.slack, .teams, .zapier, .notion, .asana, .shopify, .trello, .whatsapp, .github, .atlassian, .mailchimp, .g-calendar, .dropbox, .g-drive, .jira, .figma, .discord, .intercom'));
        
        // Position logos - wait for layout to settle, especially on mobile
        function initLogoPositioning() {
            positionLogos();
            // Use requestAnimationFrame to ensure layout is ready
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    positionLogos();
                });
            });
        }
        
        // Initial positioning
        setTimeout(initLogoPositioning, 50);
        
        // Also run on load in case DOM is already ready
        if (document.readyState === 'complete') {
            initLogoPositioning();
        } else {
            window.addEventListener('load', initLogoPositioning);
        }
        
        // Recalculate positions on window resize
        let resizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                positionLogos();
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        positionLogos();
                    });
                });
            }, 150);
        });
        
        // Get all logo boxes (rectangles + logos) for animation - scoped
        const logoBoxes = integrationsSection.querySelectorAll('.logo-box');
        
        // Set initial state - hide all logo boxes
        logoBoxes.forEach(box => {
            TweenMax.set(box, { autoAlpha: 0, y: -20, scale: 0.8 });
        });
        
        // Intersection Observer to trigger animation when section is visible
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    var tl = new TimelineMax();
                    
                    logoBoxes.forEach(function(el) {
                        var dRand = getRandomInt(0, 0.8);
                        // Smoother animation with easeOutCubic-like easing
                        tl.to(el, 1.2, { 
                            autoAlpha: 1, 
                            y: 0, 
                            scale: 1,
                            ease: Power2.easeOut
                        }, dRand);
                    });
                    
                    // Unobserve after animation is triggered
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.2, // Trigger when 20% of the section is visible
            rootMargin: '0px'
        });
        
        if (integrationsSection) {
            observer.observe(integrationsSection);
        }
  
        // Find closest rectangle to each logo and trigger hover
        const logos = integrationsSection.querySelectorAll('.slack, .teams, .zapier, .notion, .asana, .shopify, .trello, .whatsapp, .github, .atlassian, .mailchimp, .g-calendar, .dropbox, .g-drive, .jira, .figma, .discord, .intercom');
        const rectangles = integrationsSection.querySelectorAll('[class*="rectangle-"]');
  
        function findClosestRectangle(logo) {
            // Get positions relative to the container
            const logoLeft = parseFloat(getComputedStyle(logo).left) || 0;
            const logoTop = parseFloat(getComputedStyle(logo).top) || 0;
            const logoWidth = parseFloat(getComputedStyle(logo).width) || 0;
            const logoHeight = parseFloat(getComputedStyle(logo).height) || 0;
            const logoCenterX = logoLeft + logoWidth / 2;
            const logoCenterY = logoTop + logoHeight / 2;
  
            let closestRect = null;
            let minDistance = Infinity;
  
            rectangles.forEach(rect => {
                const rectLeft = parseFloat(getComputedStyle(rect).left) || 0;
                const rectTop = parseFloat(getComputedStyle(rect).top) || 0;
                const rectWidth = parseFloat(getComputedStyle(rect).width) || 0;
                const rectHeight = parseFloat(getComputedStyle(rect).height) || 0;
                const rectCenterX = rectLeft + rectWidth / 2;
                const rectCenterY = rectTop + rectHeight / 2;
  
                const distance = Math.sqrt(
                    Math.pow(logoCenterX - rectCenterX, 2) + 
                    Math.pow(logoCenterY - rectCenterY, 2)
                );
  
                if (distance < minDistance) {
                    minDistance = distance;
                    closestRect = rect;
                }
            });
  
            return closestRect;
        }
  
        logos.forEach(logo => {
            let hoveredRect = null;
  
            logo.addEventListener('mouseenter', function() {
                hoveredRect = findClosestRectangle(logo);
                if (hoveredRect) {
                    hoveredRect.classList.add('logo-hover');
                }
            });
  
            logo.addEventListener('mouseleave', function() {
                if (hoveredRect) {
                    hoveredRect.classList.remove('logo-hover');
                    hoveredRect = null;
                }
            });
        });
    });
  </script>				</div>
				</div>
		<div class="elementor-element elementor-element-59b569b e-flex e-con-boxed e-con e-parent" data-id="59b569b" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-f890a3f e-con-full e-flex e-con e-child" data-id="f890a3f" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-e33ba88 elementor-widget elementor-widget-heading" data-id="e33ba88" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Our blog</h2>				</div>
				<div class="elementor-element elementor-element-ad94f56 elementor-widget elementor-widget-heading" data-id="ad94f56" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Insights from the Telecom Industry</h2>				</div>
