							<path d="M12.0001 1.25C14.609 1.25 17.0401 1.82767 19.0431 2.82422C19.9635 3.28219 20.6145 3.5917 21.1886 4.51855C21.7721 5.46059 21.7501 6.40064 21.7501 7.74805V11.2373C21.75 17.3739 16.8468 20.7234 14.17 22.1006L14.1339 22.1191C13.4161 22.4886 12.9082 22.75 12.0001 22.75C11.0921 22.75 10.585 22.4885 9.8673 22.1191L9.83019 22.1006C7.15344 20.7234 2.25024 17.3738 2.25011 11.2373V7.74805C2.25011 6.40066 2.22818 5.46057 2.81163 4.51855C3.38573 3.59169 4.03671 3.28217 4.95714 2.82422C6.96009 1.82766 9.3912 1.25002 12.0001 1.25ZM12.0001 6.25C10.4814 6.25007 9.25011 7.48126 9.25011 9C9.25011 10.2584 10.0964 11.3157 11.2501 11.6426V15C11.2501 15.9665 12.0337 16.7499 13.0001 16.75H14.0001C14.4143 16.75 14.7501 16.4142 14.7501 16C14.7501 15.5858 14.4143 15.25 14.0001 15.25H13.0001C12.8621 15.2499 12.7501 15.138 12.7501 15V14.25H13.5001C13.9143 14.25 14.2501 13.9142 14.2501 13.5C14.2501 13.0858 13.9143 12.75 13.5001 12.75H12.7501V11.6426C13.9038 11.3158 14.7501 10.2584 14.7501 9C14.7501 7.48122 13.5189 6.25 12.0001 6.25ZM12.0001 7.75C12.6905 7.75 13.2501 8.30964 13.2501 9C13.2501 9.69036 12.6905 10.25 12.0001 10.25C11.3098 10.2499 10.7501 9.69032 10.7501 9C10.7501 8.30968 11.3098 7.75007 12.0001 7.75Z" fill="#325fec"/>
