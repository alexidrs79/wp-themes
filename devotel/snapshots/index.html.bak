		.header-login .header-arrow-up-right {
			flex-shrink: 0;
			width: 18px;
			height: 18px;
        position: relative;
			overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
		}
		.header-login .header-nav-menu-item2 {
			background: transparent;
			border-radius: var(--radius-md, 8px);
