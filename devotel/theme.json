{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    }
  }
}

